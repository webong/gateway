{
    "name": "webong/gateway-zorvia-mailbox",
    "description": "Zorvia mailbox credential-source adapter for Webong Gateway",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "webong/gateway": "dev-main"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Gateway\\ZorviaMailbox\\": "src/"
        },
        "files": [
            "register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Gateway\\ZorviaMailbox\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webong\\Gateway\\ZorviaMailbox\\ZorviaMailboxExtensionServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "pest"
    }
}
