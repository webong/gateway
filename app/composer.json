{
    "name": "webong/gateway-planner-host",
    "description": "Bundled PHP Planner host for Gateway Router",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.17",
        "spiral/roadrunner-http": "^3.3",
        "webong/gateway": "dev-main",
        "webong/gateway-planner": "dev-main",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": { "symlink": false }
        },
        {
            "type": "path",
            "url": "../pkg/planner",
            "options": { "symlink": false }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Gateway\\Router\\": ""
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "../pkg/centrifugo/composer.json",
                "../pkg/mercure/composer.json",
                "../pkg/reverb/composer.json"
            ],
            "recurse": false,
            "replace": false,
            "merge-dev": false,
            "merge-extra": false,
            "merge-scripts": false
        }
    },
    "config": {
        "vendor-dir": "../vendor",
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        }
    }
}
