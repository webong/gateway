{
    "name": "webong/gateway-planner-host",
    "description": "Bundled PHP Planner host for Gateway Router",
    "license": "MIT",
    "type": "project",
    "require": {
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.17",
        "php": "^8.3",
        "spiral/roadrunner-http": "^3.3",
        "webong/gateway": "dev-main",
        "webong/gateway-adapter": "dev-main",
        "webong/gateway-centrifugo": "dev-main",
        "webong/gateway-database": "dev-main",
        "webong/gateway-dns": "dev-main",
        "webong/gateway-email": "dev-main",
        "webong/gateway-mercure": "dev-main",
        "webong/gateway-reverb": "dev-main",
        "webong/gateway-web": "dev-main",
        "webong/proxy": "^0.2.0",
        "workerman/workerman": "^5.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../mod/adapter",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../pkg/planner",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../pkg/web",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../pkg/dns",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../pkg/email",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../pkg/database",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../pkg/centrifugo",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../pkg/mercure",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../pkg/reverb",
            "options": {
                "symlink": false
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Gateway\\Router\\": ""
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/tinker",
                "nunomaduro/collision",
                "orchestra/canvas",
                "orchestra/testbench",
                "pestphp/pest-plugin-laravel",
                "webong/composer-source-plugin"
            ]
        }
    },
    "config": {
        "vendor-dir": "../vendor",
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
