{
    frankenphp
    gateway_smtp {
        listen {$GATEWAY_ROUTER_SMTP_LISTEN:0.0.0.0:2525}
        planner_url http://127.0.0.1:8080
        internal_token {$GATEWAY_INTERNAL_TOKEN}
        hostname {$GATEWAY_SMTP_HOSTNAME:gateway.local}
        recipient_preflight true
        spool_path {$GATEWAY_SMTP_DELIVERY_SPOOL_PATH}
        mailbox_resolver_url http://127.0.0.1:8080
    }
}

{$GATEWAY_ROUTER_LISTEN} {
    root * {$GATEWAY_ROUTER_APP_DIR}

    route {
        gateway {
            internal_token {$GATEWAY_INTERNAL_TOKEN}
            relay_path_prefix /hooks
            # To route workloads started by a separate provisioning worker,
            # uncomment and replace with only reachable workload networks:
            # managed_route_cidrs 10.244.0.0/16
            max_body_size 10485760
            max_workers 100
            max_queue_size 1000
            webstream_max_connections 1000
            webstream_max_duration 24h
            spool_path {$GATEWAY_DELIVERY_SPOOL_PATH}
            admin_addr {$GATEWAY_DELIVERY_ADMIN_ADDR}
        }

        # Only the front controller is executable; never serve host files.
        rewrite * /index.php
        php
    }
}

# Never route this listener through the public gateway handler. Planner verifies
# the internal or target-worker credential on every provisioning request.
:{$GATEWAY_ROUTER_CONTROL_PORT} {
    bind {$GATEWAY_ROUTER_CONTROL_BIND}
    root * {$GATEWAY_ROUTER_APP_DIR}

    route {
        @provisioning path /_internal/provisioning /_internal/provisioning/*
        handle @provisioning {
            rewrite * /index.php
            php
        }
        respond 404
    }
}
