{
  "description": "Endpoint-owned Proxy profiles, the Gateway wire transport the Planner serializes from them, and how Spinner must route requests with it. tests/Feature/EndpointHttpTransportResolverTest.php (PHP) and pkg/spinner/internal/forwarding/profile_fixture_test.go (Go) both read this file, so the two languages cannot drift apart. Proxy v0.3.1 defines the portable profile; Gateway adds stream_headers.",
  "profiles": [
    {
      "name": "default_profile",
      "configuration": {},
      "wire": {},
      "requests": []
    },
    {
      "name": "one_proxy_for_both_schemes",
      "configuration": {"proxy": "http://proxy.example.test:8080"},
      "wire": {"proxy": {"http": "http://proxy.example.test:8080", "https": "http://proxy.example.test:8080"}},
      "requests": [
        {"url": "http://hooks.example.test/delivery", "proxy": "http://proxy.example.test:8080"},
        {"url": "https://hooks.example.test/delivery", "proxy": "http://proxy.example.test:8080"}
      ]
    },
    {
      "name": "proxy_per_scheme_with_bypass_rules",
      "configuration": {
        "proxy": {
          "http": "http://proxy.example.test:8080",
          "https": "socks5h://proxy.example.test:1080",
          "no": [".internal.example.test", "metadata.example.test", "10.0.0.5"]
        },
        "options": {"connect_timeout": 5, "timeout": 15}
      },
      "wire": {
        "proxy": {
          "http": "http://proxy.example.test:8080",
          "https": "socks5h://proxy.example.test:1080",
          "no_proxy": [".internal.example.test", "metadata.example.test", "10.0.0.5"]
        },
        "connect_timeout_seconds": 5.0,
        "request_timeout_seconds": 15.0
      },
      "connect_timeout_ms": 5000,
      "request_timeout_ms": 15000,
      "requests": [
        {"url": "http://hooks.example.test/delivery", "proxy": "http://proxy.example.test:8080"},
        {"url": "http://hooks.internal.example.test/delivery", "proxy": null},
        {"url": "http://HOOKS.Internal.Example.Test./delivery", "proxy": null},
        {"url": "http://internal.example.test/delivery", "proxy": "http://proxy.example.test:8080"},
        {"url": "http://metadata.example.test/latest", "proxy": null},
        {"url": "http://api.metadata.example.test/latest", "proxy": null},
        {"url": "http://notmetadata.example.test/latest", "proxy": "http://proxy.example.test:8080"},
        {"url": "http://10.0.0.5/latest", "proxy": null},
        {"url": "http://10.0.0.6/latest", "proxy": "http://proxy.example.test:8080"}
      ]
    },
    {
      "name": "proxy_for_https_only",
      "configuration": {"proxy": {"https": "http://proxy.example.test:3128"}},
      "wire": {"proxy": {"https": "http://proxy.example.test:3128"}},
      "requests": [
        {"url": "http://hooks.example.test/delivery", "proxy": null},
        {"url": "https://hooks.example.test/delivery", "proxy": "http://proxy.example.test:3128"}
      ]
    },
    {
      "name": "options_proxy_without_top_level_proxy",
      "configuration": {"options": {"proxy": {"https": "http://options.example.test:3128", "no": ["bypass.example.test"]}}},
      "wire": {"proxy": {"https": "http://options.example.test:3128", "no_proxy": ["bypass.example.test"]}},
      "requests": [
        {"url": "https://hooks.example.test/delivery", "proxy": "http://options.example.test:3128"},
        {"url": "https://bypass.example.test/delivery", "proxy": null}
      ]
    },
    {
      "name": "top_level_proxy_wins_over_options_proxy",
      "configuration": {"proxy": "http://top.example.test:1", "options": {"proxy": "http://options.example.test:2"}},
      "wire": {"proxy": {"http": "http://top.example.test:1", "https": "http://top.example.test:1"}},
      "requests": [
        {"url": "http://hooks.example.test/delivery", "proxy": "http://top.example.test:1"}
      ]
    },
    {
      "name": "omitted_timeouts_keep_the_deployment_default",
      "configuration": {"proxy": "http://proxy.example.test:8080"},
      "wire": {"proxy": {"http": "http://proxy.example.test:8080", "https": "http://proxy.example.test:8080"}},
      "connect_timeout_ms": 0,
      "request_timeout_ms": 0,
      "requests": []
    },
    {
      "name": "fractional_timeouts",
      "configuration": {"options": {"connect_timeout": 0.25, "timeout": 1.5}},
      "wire": {"connect_timeout_seconds": 0.25, "request_timeout_seconds": 1.5},
      "connect_timeout_ms": 250,
      "request_timeout_ms": 1500,
      "requests": []
    },
    {
      "name": "proxy_authentication",
      "configuration": {"proxy": {"http": "http://user:p%40ss@proxy.example.test:8080", "https": "socks5h://user:secret@proxy.example.test:1080"}},
      "wire": {"proxy": {"http": "http://user:p%40ss@proxy.example.test:8080", "https": "socks5h://user:secret@proxy.example.test:1080"}},
      "requests": [
        {"url": "http://hooks.example.test/delivery", "proxy": "http://user:p%40ss@proxy.example.test:8080"}
      ]
    },
    {
      "name": "bypass_everything",
      "configuration": {"proxy": {"http": "http://proxy.example.test:8080", "https": "http://proxy.example.test:8080", "no": ["*"]}},
      "wire": {"proxy": {"http": "http://proxy.example.test:8080", "https": "http://proxy.example.test:8080", "no_proxy": ["*"]}},
      "requests": [
        {"url": "http://hooks.example.test/delivery", "proxy": null},
        {"url": "https://hooks.example.test/delivery", "proxy": null}
      ]
    },
    {
      "name": "bypass_rules_without_a_proxy",
      "configuration": {"proxy": {"no": [".internal.example.test"]}},
      "wire": {"proxy": {"no_proxy": [".internal.example.test"]}},
      "requests": [
        {"url": "http://hooks.example.test/delivery", "proxy": null},
        {"url": "http://hooks.internal.example.test/delivery", "proxy": null}
      ]
    },
    {
      "name": "gateway_headers_stay_beside_the_profile",
      "configuration": {
        "proxy": "http://proxy.example.test:8080",
        "options": {
          "headers": {"X-Source-Scope": ["orders", "events"], "Authorization": "Bearer source-secret"},
          "verify": false,
          "allow_redirects": false,
          "auth": ["user", "password"],
          "cookies": true,
          "http_errors": false
        }
      },
      "wire": {
        "proxy": {"http": "http://proxy.example.test:8080", "https": "http://proxy.example.test:8080"},
        "stream_headers": {"X-Source-Scope": ["orders", "events"], "Authorization": ["Bearer source-secret"]}
      },
      "requests": []
    }
  ],
