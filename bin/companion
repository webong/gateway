<?php

declare(strict_types=1);

use Webong\Gateway\Companion\CompanionProcessGuest;
use Webong\Gateway\HookScript\HookScriptCompanionAction;
use Webong\Gateway\HookScript\HookScriptRuntime;

$autoloaders = [
    dirname(__DIR__).'/vendor/autoload.php',
    dirname(__DIR__, 3).'/vendor/autoload.php',
];
foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        break;
    }
}
if (! class_exists(CompanionProcessGuest::class)) {
    fwrite(STDERR, "Gateway companion autoloader is unavailable.\n");
    exit(1);
}

$extension = getenv('GATEWAY_EXT_ID') ?: '';
$revision = getenv('GATEWAY_EXT_REVISION') ?: '';
$version = getenv('GATEWAY_EXT_VERSION');
$version = $version === false || $version === '' ? null : $version;

$runtime = new HookScriptRuntime(
    maxSourceBytes: 65536,
    timeoutSeconds: 1,
    maxDeliveries: 32,
    maxSchedules: 8,
    maxLogs: 100,
);
$action = new HookScriptCompanionAction($runtime);
$guest = new CompanionProcessGuest(
    extension: $extension,
    revision: $revision,
    version: $version,
    actions: [HookScriptCompanionAction::NAME => $action],
);

exit($guest->serve());
