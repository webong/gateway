version: "3"

server:
  # This is the PHP worker, not `octane:start` (that command launches its own
  # RoadRunner process). Set the absolute Laravel application path when the Go
  # host and Laravel application do not share a working directory.
  command: "php /path/to/laravel/vendor/bin/roadrunner-worker"
  env:
    APP_BASE_PATH: "/path/to/laravel"
    LARAVEL_OCTANE: "1"

http:
  address: "0.0.0.0:5001"
  middleware: ["gateway", "gzip"]
  max_request_size: 10
  pool:
    # A fixed pool stays warm; do not enable a dynamic allocator that can scale
    # the PHP control plane to zero when predictable ingress latency matters.
    # Start with ceil(target_rps * measured_p95_seconds * 1.5), then cap and
    # validate against the container's CPU and memory. Four is a conservative
    # example for a small deployment, not a universal production value.
    num_workers: 4
    # Recycle workers periodically without cold-starting the entire pool.
    max_jobs: 1000
    allocate_timeout: 10s
    destroy_timeout: 10s

logs:
  level: "info"
