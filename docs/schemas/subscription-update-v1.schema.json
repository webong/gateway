{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webong/gateway/blob/main/docs/schemas/subscription-update-v1.schema.json",
  "title": "Gateway subscription update v1",
  "description": "Core fields for PATCH /registry/endpoints/{endpointKey}/subscriptions/{destinationId}. Requires the current ETag in If-Match. Installed target extensions define the fields used to change their target.",
  "type": "object",
  "additionalProperties": true,
  "minProperties": 1,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "relay",
        "reply"
      ]
    },
    "channel": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "not": {
          "anyOf": [
            {
              "enum": [
                "subscriber_id",
                "delivery_mode",
                "target_kind"
              ]
            },
            {
              "pattern": "^_"
            }
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "anyOf": [
    {
      "required": [
        "type"
      ]
    },
    {
      "required": [
        "metadata"
      ]
    }
  ]
}
