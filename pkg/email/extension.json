{
    "identity": "webong/email",
    "spinner": "./cmd/spinner",
    "contracts": [
        {
            "name": "gateway.runtime",
            "version": "v1",
            "operations": [
                {"name": "start", "surface": "spinner"}
            ]
        },
        {
            "name": "gateway.delivery-adapter",
            "version": "v1",
            "operations": [
                {"name": "deliver", "surface": "spinner"}
            ]
        },
        {
            "name": "gateway.job",
            "version": "v1",
            "operations": [
                {"name": "run", "surface": "spinner"}
            ]
        },
        {
            "name": "gateway.delivery-failure",
            "version": "v1",
            "operations": [
                {"name": "follow-up", "surface": "spinner"}
            ]
        }
    ],
    "reverse": [
        {
            "name": "gateway.planner",
            "version": "v1",
            "operations": [
                {"name": "plan-event"},
                {"name": "pass-through"},
                {"name": "private-pass-through"}
            ]
        },
        {
            "name": "gateway.delivery",
            "version": "v1",
            "operations": [
                {"name": "deliver"},
                {"name": "enqueue-gateway"},
                {"name": "enqueue-gateway-idempotent"},
                {"name": "supports-delivery-adapter"},
                {"name": "durable"}
            ]
        },
        {
            "name": "gateway.dns",
            "version": "v1",
            "operations": [
                {"name": "exchange"}
            ]
        }
    ],
    "requires": [
        {
            "contract": {"name": "gateway.dns", "version": "v1"},
            "operation": "exchange"
        }
    ]
}
