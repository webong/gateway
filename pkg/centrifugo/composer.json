{
    "name": "webong/gateway-centrifugo",
    "description": "Centrifugo workload integration for Webong Gateway",
    "type": "library",
    "license": "MIT",
    "require": {
        "illuminate/database": "^12.0",
        "laravel/framework": "^12.0",
        "php": "^8.3",
        "webong/gateway": "dev-main",
        "webong/gateway-adapter": "dev-main",
        "webong/proxy": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Gateway\\Centrifugo\\": "src/"
        },
        "files": [
            "register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Gateway\\Centrifugo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webong\\Gateway\\Centrifugo\\CentrifugoIntegrationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
