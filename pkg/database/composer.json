{
    "name": "webong/gateway-database",
    "description": "Managed Database extension for Gateway",
    "type": "library",
    "license": "MIT",
    "require": {
        "laravel/framework": "^12.0",
        "php": "^8.3",
        "webong/gateway": "dev-main",
        "webong/gateway-adapter": "dev-main",
        "webong/proxy": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Gateway\\Database\\": "src/"
        },
        "files": [
