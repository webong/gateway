<?php

declare(strict_types=1);

use Webong\GatewayBuilder\PackageBuilder;

$autoload = is_file(dirname(__DIR__).'/vendor/autoload.php')
    ? dirname(__DIR__).'/vendor/autoload.php'
    : dirname(__DIR__, 3).'/vendor/autoload.php';
require $autoload;

if ($argc < 3 || $argc > 4) {
    fwrite(STDERR, "Usage: php scripts/build-ext-package DESTINATION VERSION [REVISION]\n");
    exit(2);
}

$source = dirname(__DIR__);
$destination = rtrim($argv[1], DIRECTORY_SEPARATOR);
$version = $argv[2];
$revision = $argv[3] ?? null;
$vendor = (string) (getenv('GATEWAY_HOOKSCRIPT_VENDOR_DIR') ?: $source.'/companion/vendor');

if (! is_file($vendor.'/autoload.php')) {
    fwrite(STDERR, "Run composer install --no-dev in pkg/hookscript/companion before building the ext package.\n");
    exit(1);
}

$temporary = sys_get_temp_dir().'/gateway-hookscript-build-'.bin2hex(random_bytes(8));
$generated = $temporary.'/generated';
$goCache = $temporary.'/go-cache';

/** @param list<string> $command */
function runHookScriptBuild(array $command, string $directory, array $environment, bool $capture = false): string
{
    $pipes = [];
    $process = proc_open(
        $command,
        [0 => ['pipe', 'r'], 1 => $capture ? ['pipe', 'w'] : STDOUT, 2 => STDERR],
        $pipes,
        $directory,
        $environment,
    );
    if (! is_resource($process)) {
        throw new RuntimeException('Cannot start the HookScript Spinner build.');
    }
    fclose($pipes[0]);
    $output = $capture ? trim((string) stream_get_contents($pipes[1])) : '';
    if ($capture) {
        fclose($pipes[1]);
    }
    if (proc_close($process) !== 0 || ($capture && $output === '')) {
        throw new RuntimeException('Cannot build or inspect the HookScript Spinner guest.');
    }

    return $output;
}

function removeHookScriptBuildTree(string $directory): void
{
    if (! is_dir($directory)) {
        return;
    }
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($directory, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::CHILD_FIRST,
    );
    foreach ($iterator as $entry) {
        $entry->isDir() ? @rmdir($entry->getPathname()) : @unlink($entry->getPathname());
    }
    @rmdir($directory);
}

try {
    if (! mkdir($generated, 0700, true) || ! mkdir($goCache, 0700, true)) {
        throw new RuntimeException('Cannot create the HookScript build workspace.');
    }
    $environment = array_merge(getenv(), ['GOCACHE' => $goCache]);
    runHookScriptBuild(
        ['go', 'build', '-trimpath', '-ldflags=-s -w', '-o', $generated.'/spinner', './cmd/spinner'],
        $source,
        $environment,
    );
    $targetOS = runHookScriptBuild(['go', 'env', 'GOOS'], $source, $environment, true);
    $targetArch = runHookScriptBuild(['go', 'env', 'GOARCH'], $source, $environment, true);

    (new PackageBuilder)->build(
        manifestPath: $source.'/extension.build.json',
        version: $version,
        output: $destination,
        revision: $revision,
        sourceRoots: [
            'project' => $source,
            'generated' => $generated,
            'vendor' => $vendor,
        ],
        values: ['target_os' => $targetOS, 'target_arch' => $targetArch],
    );
    fwrite(STDOUT, $destination."\n");
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage()."\n");
    exit(1);
} finally {
    removeHookScriptBuildTree($temporary);
}
