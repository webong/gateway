{
    "name": "webong/gateway-mercure",
    "description": "Mercure Hub workload integration for Webong Gateway",
    "type": "library",
    "license": "MIT",
    "require": {
        "illuminate/database": "^12.0",
        "laravel/framework": "^12.0",
        "php": "^8.3",
        "webong/gateway": "dev-main",
        "webong/gateway-adapter": "dev-main",
        "webong/proxy": "^0.2.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Gateway\\Mercure\\": "src/"
        },
        "files": [
            "register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Gateway\\Mercure\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webong\\Gateway\\Mercure\\MercureIntegrationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
