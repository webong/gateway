{
    "name": "webong/gateway-weaver",
    "description": "Queue-authoritative WorkFlow runtime and Planner extension for Gateway",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "webong/workflow": "0.1.0-rc.2",
        "webong/composer-source-plugin": "^0.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "symfony/yaml": "^7.4",
        "justinrainbow/json-schema": "^5.2"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Gateway\\Weaver\\": "src/"
        },
        "files": [
            "register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Gateway\\Weaver\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/webong/workflow",
            "no-api": true
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --fail-on-skipped"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "webong/composer-source-plugin": true
        }
    },
    "extra": {
        "source-plugin": {
            "projections": {
                "webong/workflow": {
                    "surfaces": [
                        "core"
                    ]
                }
            }
        }
    },
    "suggest": {
        "webong/gateway": "Required by the optional Planner resource entrypoint.",
        "webong/gateway-adapter": "Required to register the Planner entrypoint through Gateway provider discovery."
    }
}
