#!/usr/bin/env bash
set -euo pipefail

# Create a local release tag from committed source without changing the checkout.
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
VERSION=${1:-}
if [[ $# != 1 || ! "$VERSION" =~ ^v(0|1)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    echo 'Usage: scripts/release-driver v0.MINOR.PATCH (or v1.MINOR.PATCH)' >&2
    exit 2
fi
cd "$ROOT"
TAG="driver/$VERSION"
if git show-ref --verify --quiet "refs/tags/$TAG"; then
    echo "Release tag already exists: $TAG" >&2
    exit 1
fi
if [[ -n "$(git status --porcelain --untracked-files=all -- mod/driver)" ]]; then
    echo 'Commit mod/driver changes before creating a release.' >&2
    exit 1
fi

SOURCE=$(git rev-parse HEAD)
DRIVER_TREE=$(git rev-parse "$SOURCE:mod/driver")
git show "$SOURCE:mod/driver/go.mod" | grep -qx 'module github.com/webong/gateway/driver'
git cat-file -e "$SOURCE:mod/driver/LICENSE"

# GitHub resolves .../gateway/driver at driver/, even though development
# sources live in mod/driver/. Only the release commit uses this layout.
RELEASE_TREE=$(printf '040000 tree %s\tdriver\n' "$DRIVER_TREE" | git mktree)
RELEASE_COMMIT=$(git commit-tree "$RELEASE_TREE" -p "$SOURCE" \
    -m "Release Gateway driver $VERSION" -m "Source: $SOURCE (mod/driver)")
git tag -a "$TAG" "$RELEASE_COMMIT" -m "Gateway driver $VERSION; source $SOURCE"
printf 'Created %s at %s\n' "$TAG" "$RELEASE_COMMIT"
printf 'Checkout unchanged. Publish explicitly: git push upstream refs/tags/%s\n' "$TAG"
