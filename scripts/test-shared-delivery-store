#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
NAME="gateway-shared-delivery-test-${RANDOM}${RANDOM}"
ROUTER_DATA_DIR=$(mktemp -d "${TMPDIR:-/tmp}/gateway-router-pg-test.XXXXXX")
cleanup() {
    docker stop "$NAME" >/dev/null 2>&1 || true
    if [ -d "$ROUTER_DATA_DIR" ]; then
        rm -r -- "$ROUTER_DATA_DIR"
    fi
}
trap cleanup EXIT INT TERM

docker run --rm -d --pull never --name "$NAME" \
    -e POSTGRES_PASSWORD=gateway-test-only -e POSTGRES_DB=gateway_test \
    -p 127.0.0.1::5432 postgres:16-alpine >/dev/null
for _ in $(seq 1 100); do
    if docker exec "$NAME" pg_isready -h 127.0.0.1 -U postgres -d gateway_test >/dev/null 2>&1; then
        break
    fi
    sleep 0.2
done
if ! docker exec "$NAME" pg_isready -h 127.0.0.1 -U postgres -d gateway_test >/dev/null; then
    docker logs --tail 30 "$NAME" >&2 || true
    echo "PostgreSQL test container did not become ready" >&2
    exit 1
fi
port=$(docker port "$NAME" 5432/tcp | sed -n '1{s/.*://;p;}')
if [[ ! "$port" =~ ^[1-9][0-9]*$ ]]; then
    echo "Could not resolve PostgreSQL test port" >&2
    exit 1
fi

docker exec "$NAME" createdb -U postgres gateway_router_test
router_dsn="postgres://postgres:gateway-test-only@127.0.0.1:$port/gateway_router_test?sslmode=disable"
GATEWAY_ROUTER_DATA_DIR="$ROUTER_DATA_DIR" \
GATEWAY_ROUTER_LIBRARY_BIN=/usr/bin/true \
GATEWAY_DELIVERY_DATABASE_URL="$router_dsn" \
DB_CONNECTION=pgsql \
    "$ROOT/scripts/router-start" library >/dev/null
tables=$(docker exec "$NAME" psql -U postgres -d gateway_router_test -At \
    -c "SELECT count(*) FROM information_schema.tables WHERE table_schema = 'public' AND table_name = 'deliveries'")
if [ "$tables" != 1 ]; then
    echo "Bundled Planner did not migrate the PostgreSQL deliveries table" >&2
    exit 1
fi
session_column=$(docker exec "$NAME" psql -U postgres -d gateway_router_test -At \
    -c "SELECT data_type || ':' || character_maximum_length FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'nodes' AND column_name = 'session_id'")
if [ "$session_column" != 'character varying:32' ]; then
    echo "Bundled Planner did not migrate nodes.session_id as varchar(32): $session_column" >&2
    exit 1
fi

GOTELEMETRY=off GATEWAY_SHARED_PG_TEST_DSN="postgres://postgres:gateway-test-only@127.0.0.1:$port/gateway_test?sslmode=disable" \
    go -C "$ROOT" test -mod=mod ./pkg/spinner/bridge/deliveryqueue/sharedpg -count=1
GOTELEMETRY=off GATEWAY_SHARED_PG_TEST_DSN="postgres://postgres:gateway-test-only@127.0.0.1:$port/gateway_test?sslmode=disable" \
    go -C "$ROOT" test -mod=mod ./pkg/spinner/bridge/deliveryqueue -run '^TestSharedQueue(AcrossTwoWorkers|TakesOverAfterWorkerProcessDies|OnlyClaimsSupportedAdapters)$' -count=1
GOTELEMETRY=off GATEWAY_SHARED_PG_TEST_DSN="postgres://postgres:gateway-test-only@127.0.0.1:$port/gateway_test?sslmode=disable" \
    GOWORK=off go -C "$ROOT/pkg/caddy" test -mod=mod ./... -run '^TestCaddySharedPostgresQueuesProvision$' -count=1
GOTELEMETRY=off GATEWAY_DELIVERY_MEMBERSHIP_TEST_DSN="$router_dsn" \
    go -C "$ROOT" test -mod=mod ./pkg/spinner/bridge/deliverymembership -count=1
GOTELEMETRY=off GATEWAY_DELIVERY_MEMBERSHIP_TEST_DSN="$router_dsn" \
    GOWORK=off go -C "$ROOT/pkg/caddy" test -mod=mod ./... -run '^TestCaddyDeliveryAdminMembership$' -count=1
