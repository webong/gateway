#!/bin/sh
set -eu

if [ "$(id -u)" -eq 0 ]; then
    if command -v su-exec >/dev/null 2>&1; then
        exec su-exec "${GATEWAY_ROUTER_RUN_AS_USER:-www-data}" "$0" "$@"
    fi
    if command -v gosu >/dev/null 2>&1; then
        exec gosu "${GATEWAY_ROUTER_RUN_AS_USER:-www-data}" "$0" "$@"
    fi
    echo 'Refusing to run Gateway Router commands as root without a privilege-drop helper.' >&2
    exit 1
fi

REPO_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export GATEWAY_ROUTER_APP_DIR=${GATEWAY_ROUTER_APP_DIR:-$REPO_DIR/app}
export GATEWAY_ROUTER_DATA_DIR=${GATEWAY_ROUTER_DATA_DIR:-$REPO_DIR/.gateway-router-data}
export GATEWAY_ROUTER_LISTEN=${GATEWAY_ROUTER_LISTEN:-127.0.0.1:8080}
if [ -z "${GATEWAY_ROUTER_ROADRUNNER_BIN:-}" ] && [ -x "$REPO_DIR/bin/gateway-router-roadrunner" ]; then
    export GATEWAY_ROUTER_ROADRUNNER_BIN="$REPO_DIR/bin/gateway-router-roadrunner"
fi
if [ -z "${GATEWAY_ROUTER_FRANKENPHP_BIN:-}" ] && [ -x "$REPO_DIR/bin/gateway-frankenphp" ]; then
    export GATEWAY_ROUTER_FRANKENPHP_BIN="$REPO_DIR/bin/gateway-frankenphp"
fi
if [ -z "${GATEWAY_ROUTER_LIBRARY_BIN:-}" ] && [ -x "$REPO_DIR/bin/gateway-router-library" ]; then
    export GATEWAY_ROUTER_LIBRARY_BIN="$REPO_DIR/bin/gateway-router-library"
fi

case "${1:-}" in
    library|frankenphp|roadrunner)
        exec "$REPO_DIR/scripts/router-start" "$1"
        ;;
    artisan)
        shift
        exec "$REPO_DIR/scripts/router-artisan" "$@"
        ;;
    *)
        echo 'Usage: scripts/gateway-router {library|frankenphp|roadrunner|artisan <command>}' >&2
        exit 2
        ;;
esac
