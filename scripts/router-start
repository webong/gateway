#!/bin/sh
set -eu

APP_DIR=${GATEWAY_ROUTER_APP_DIR:-$(CDPATH= cd -- "$(dirname -- "$0")/../app" && pwd)}
DATA_DIR=${GATEWAY_ROUTER_DATA_DIR:-/data}
RUNTIME=${1:-${GATEWAY_ROUTER_RUNTIME:-frankenphp}}
APP_DIR=$(CDPATH= cd -- "$APP_DIR" && pwd)

case "$RUNTIME" in
    library|frankenphp|roadrunner) ;;
    *) echo 'Usage: start [library|frankenphp|roadrunner]' >&2; exit 2 ;;
esac

if [ ! -f "$APP_DIR/../vendor/autoload.php" ]; then
    echo "Planner dependencies are missing; run composer install --working-dir=$APP_DIR" >&2
    exit 1
fi

mkdir -p "$DATA_DIR" "$DATA_DIR/storage/framework/cache/data" \
    "$DATA_DIR/storage/framework/sessions" "$DATA_DIR/storage/framework/views" \
    "$DATA_DIR/cache"
DATA_DIR=$(CDPATH= cd -- "$DATA_DIR" && pwd)

if [ -n "${GATEWAY_DELIVERY_DATABASE_URL:-}" ]; then
    if [ -n "${GATEWAY_DELIVERY_SPOOL_PATH:-}" ]; then
        echo 'GATEWAY_DELIVERY_SPOOL_PATH and GATEWAY_DELIVERY_DATABASE_URL are mutually exclusive.' >&2
        exit 1
    fi
    if [ -n "${DB_CONNECTION:-}" ] && [ "$DB_CONNECTION" != pgsql ]; then
        echo 'Bundled Router shared deliveries require DB_CONNECTION=pgsql.' >&2
        exit 1
    fi
    if [ -n "${DB_URL:-}" ] && [ "$DB_URL" != "$GATEWAY_DELIVERY_DATABASE_URL" ]; then
        echo 'Bundled Router requires DB_URL and GATEWAY_DELIVERY_DATABASE_URL to name the same PostgreSQL database.' >&2
        exit 1
    fi
    export DB_CONNECTION=pgsql
    export DB_URL=$GATEWAY_DELIVERY_DATABASE_URL
    # Registry route generations and subscription locks must be visible to
    # every Planner replica sharing this database.
    export GATEWAY_CACHE_STORE=${GATEWAY_CACHE_STORE:-database}
    export GATEWAY_MUTATION_LOCK_STORE=${GATEWAY_MUTATION_LOCK_STORE:-$GATEWAY_CACHE_STORE}
else
    export GATEWAY_DELIVERY_SPOOL_PATH=${GATEWAY_DELIVERY_SPOOL_PATH:-$DATA_DIR/deliveries}
fi
# Bundled Router runtimes default the admin listener to loopback. Operators
# using multiple private shared-queue origins must bind each listener to its
# trusted internal network without publishing the port publicly.
export GATEWAY_DELIVERY_ADMIN_ADDR=${GATEWAY_DELIVERY_ADMIN_ADDR:-127.0.0.1:5052}
export GATEWAY_DELIVERY_ADMIN_URL=${GATEWAY_DELIVERY_ADMIN_URL:-http://127.0.0.1:5052}
case "${GATEWAY_DELIVERY_ADMIN_DISCOVERY_ENABLED:-false}" in
    true|1)
        if [ -z "${GATEWAY_DELIVERY_DATABASE_URL:-}" ] || [ -z "${GATEWAY_DELIVERY_ADMIN_ADVERTISE_URL:-}" ]; then
            echo 'Delivery admin discovery requires shared PostgreSQL and GATEWAY_DELIVERY_ADMIN_ADVERTISE_URL.' >&2
            exit 1
        fi
        ;;
esac

if [ -n "${GATEWAY_ROUTER_CREDENTIALS_FILE:-}" ]; then
    CREDENTIALS_FILE=$GATEWAY_ROUTER_CREDENTIALS_FILE
    if [ ! -r "$CREDENTIALS_FILE" ]; then
        echo 'GATEWAY_ROUTER_CREDENTIALS_FILE must be a readable private file.' >&2
        exit 1
    fi
    if [ -f "$DATA_DIR/gateway.env" ] && ! cmp -s "$DATA_DIR/gateway.env" "$CREDENTIALS_FILE"; then
        echo 'The mounted Router credentials differ from the persisted gateway.env.' >&2
        exit 1
    fi
else
    CREDENTIALS_FILE="$DATA_DIR/gateway.env"
    if [ ! -f "$CREDENTIALS_FILE" ]; then
        if [ -f "$DATA_DIR/gateway.sqlite" ]; then
            echo "Gateway data exists without its key file; restore $DATA_DIR/gateway.env from backup." >&2
            exit 1
        fi
        umask 077
        php -r 'printf("APP_KEY=base64:%s\nGATEWAY_INTERNAL_TOKEN=%s\nREGISTRY_TOKEN=%s\n", base64_encode(random_bytes(32)), bin2hex(random_bytes(32)), bin2hex(random_bytes(32)));' > "$CREDENTIALS_FILE"
    fi
fi

set -a
. "$CREDENTIALS_FILE"
set +a
if [ -z "${APP_KEY:-}" ] || [ -z "${GATEWAY_INTERNAL_TOKEN:-}" ] || [ -z "${REGISTRY_TOKEN:-}" ]; then
    echo 'Router credentials must define APP_KEY, GATEWAY_INTERNAL_TOKEN, and REGISTRY_TOKEN.' >&2
    exit 1
fi

export APP_ENV=production
export DB_CONNECTION=${DB_CONNECTION:-sqlite}
if [ "$DB_CONNECTION" = sqlite ]; then
    export DB_DATABASE=${DB_DATABASE:-$DATA_DIR/gateway.sqlite}
fi
export SESSION_DRIVER=file
export GATEWAY_ROUTER_DATA_DIR="$DATA_DIR"
export LARAVEL_STORAGE_PATH="$DATA_DIR/storage"
export APP_SERVICES_CACHE="$DATA_DIR/cache/services.php"
export APP_PACKAGES_CACHE="$DATA_DIR/cache/packages.php"
export APP_CONFIG_CACHE="$DATA_DIR/cache/config.php"
export APP_ROUTES_CACHE="$DATA_DIR/cache/routes-v7.php"
export APP_EVENTS_CACHE="$DATA_DIR/cache/events.php"
export GATEWAY_PATH_RESOLVER='Gateway\Router\EndpointPathResolver'
export GATEWAY_ROUTER_APP_DIR="$APP_DIR"
export GATEWAY_ROUTER_LISTEN=${GATEWAY_ROUTER_LISTEN:-:8080}
# Provisioning workers can reach this listener only when operators explicitly
# bind it to a trusted private interface; the default is local to the Router.
export GATEWAY_ROUTER_CONTROL_LISTEN=${GATEWAY_ROUTER_CONTROL_LISTEN:-127.0.0.1:5053}
# A single persistent PHP worker keeps one bounded warmed companion per active
# package revision. Values above one opt into a deployment-level worker pool.
# The Router-specific name remains a compatibility fallback; every Planner host
# now consumes the same primary deployment settings.
export GATEWAY_PLANNER_WORKERS=${GATEWAY_PLANNER_WORKERS:-${GATEWAY_ROUTER_PHP_WORKERS:-1}}
export GATEWAY_PLANNER_MAX_REQUESTS=${GATEWAY_PLANNER_MAX_REQUESTS:-500}
case "$GATEWAY_PLANNER_WORKERS" in
    ''|*[!0-9]*|0) echo 'GATEWAY_PLANNER_WORKERS must be a positive integer.' >&2; exit 1 ;;
esac
case "$GATEWAY_PLANNER_MAX_REQUESTS" in
    ''|*[!0-9]*|0) echo 'GATEWAY_PLANNER_MAX_REQUESTS must be a positive integer.' >&2; exit 1 ;;
esac

# Planner owns mailbox upstream hosts and network scope. Spinner resolves
# credentials privately and enforces the scope against DNS results when dialing.
if [ "$RUNTIME" = library ] || [ "$RUNTIME" = roadrunner ]; then
    export GATEWAY_MAILBOX_SMTP_RESOLVER_URL=${GATEWAY_MAILBOX_SMTP_RESOLVER_URL:-http://127.0.0.1:5053}
    export GATEWAY_OUTBOUND_RESOLVER_URL=${GATEWAY_OUTBOUND_RESOLVER_URL:-http://127.0.0.1:5053}
    export GATEWAY_EMAIL_DKIM_RESOLVER_URL=${GATEWAY_EMAIL_DKIM_RESOLVER_URL:-http://127.0.0.1:5053}
fi
if [ "$RUNTIME" = frankenphp ] && [ -z "${GATEWAY_DELIVERY_DATABASE_URL:-}" ]; then
    export GATEWAY_SMTP_DELIVERY_SPOOL_PATH=${GATEWAY_SMTP_DELIVERY_SPOOL_PATH:-$DATA_DIR/smtp-deliveries}
fi

if [ -n "${GATEWAY_ROUTER_TLS_LISTEN:-}" ]; then
    TLS_NAME=${GATEWAY_ROUTER_TLS_NAME:-gateway}
    if ! php -r 'exit(preg_match("/^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$/D", $argv[1]) === 1 ? 0 : 1);' "$TLS_NAME"; then
        echo 'GATEWAY_ROUTER_TLS_NAME must be a DNS hostname.' >&2
        exit 1
    fi
    if [ -n "${GATEWAY_ROUTER_TLS_CERT_FILE:-}" ] || [ -n "${GATEWAY_ROUTER_TLS_KEY_FILE:-}" ]; then
        if [ -z "${GATEWAY_ROUTER_TLS_CERT_FILE:-}" ] || [ -z "${GATEWAY_ROUTER_TLS_KEY_FILE:-}" ] ||
            [ ! -r "$GATEWAY_ROUTER_TLS_CERT_FILE" ] || [ ! -r "$GATEWAY_ROUTER_TLS_KEY_FILE" ]; then
            echo 'Both mounted Router TLS certificate and key must be readable.' >&2
            exit 1
        fi
    else
        mkdir -p "$DATA_DIR/tls"
        export GATEWAY_ROUTER_TLS_CERT_FILE="$DATA_DIR/tls/server.crt"
        export GATEWAY_ROUTER_TLS_KEY_FILE="$DATA_DIR/tls/server.key"
        if [ ! -f "$GATEWAY_ROUTER_TLS_CERT_FILE" ] && [ ! -f "$GATEWAY_ROUTER_TLS_KEY_FILE" ]; then
            umask 077
            openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days 365 \
                -subj "/CN=$TLS_NAME" \
                -addext "subjectAltName=DNS:$TLS_NAME,DNS:localhost,IP:127.0.0.1" \
                -keyout "$GATEWAY_ROUTER_TLS_KEY_FILE" -out "$GATEWAY_ROUTER_TLS_CERT_FILE" >/dev/null 2>&1
        fi
        if [ ! -r "$GATEWAY_ROUTER_TLS_CERT_FILE" ] || [ ! -r "$GATEWAY_ROUTER_TLS_KEY_FILE" ]; then
            echo 'Persisted Router TLS certificate or key is missing; restore both from backup.' >&2
            exit 1
        fi
    fi
    export GATEWAY_IMAP_TLS_CERT_FILE=${GATEWAY_IMAP_TLS_CERT_FILE:-$GATEWAY_ROUTER_TLS_CERT_FILE}
    export GATEWAY_IMAP_TLS_KEY_FILE=${GATEWAY_IMAP_TLS_KEY_FILE:-$GATEWAY_ROUTER_TLS_KEY_FILE}
fi
if [ "$RUNTIME" = frankenphp ]; then
    case "$GATEWAY_ROUTER_CONTROL_LISTEN" in
        *:*)
            GATEWAY_ROUTER_CONTROL_BIND=${GATEWAY_ROUTER_CONTROL_LISTEN%:*}
            GATEWAY_ROUTER_CONTROL_PORT=${GATEWAY_ROUTER_CONTROL_LISTEN##*:}
            ;;
        *)
            echo 'GATEWAY_ROUTER_CONTROL_LISTEN must be an IP address and port.' >&2
            exit 1
            ;;
    esac
    case "$GATEWAY_ROUTER_CONTROL_BIND" in
        \[*\])
            GATEWAY_ROUTER_CONTROL_BIND=${GATEWAY_ROUTER_CONTROL_BIND#\[}
            GATEWAY_ROUTER_CONTROL_BIND=${GATEWAY_ROUTER_CONTROL_BIND%\]}
            ;;
    esac
    if [ -z "$GATEWAY_ROUTER_CONTROL_BIND" ] || [ -z "$GATEWAY_ROUTER_CONTROL_PORT" ]; then
        echo 'GATEWAY_ROUTER_CONTROL_LISTEN must be an IP address and port.' >&2
        exit 1
    fi
    export GATEWAY_ROUTER_CONTROL_BIND GATEWAY_ROUTER_CONTROL_PORT
fi
export LOG_LEVEL=${LOG_LEVEL:-info}
export MAX_WORKERS=${MAX_WORKERS:-4}

if [ "$DB_CONNECTION" = sqlite ] && [ ! -f "$DB_DATABASE" ]; then
    touch "$DB_DATABASE"
fi

php "$APP_DIR/artisan" migrate --realpath --path="$APP_DIR/../vendor/webong/proxy/database/migrations" --force
php "$APP_DIR/artisan" migrate --force

if [ "$RUNTIME" = library ]; then
    LIBRARY_BIN=${GATEWAY_ROUTER_LIBRARY_BIN:-}
    if [ -z "$LIBRARY_BIN" ] || [ ! -x "$LIBRARY_BIN" ]; then
        echo 'Build the FrankenPHP library Router with scripts/build-router-library first.' >&2
        exit 1
    fi
    exec "$LIBRARY_BIN"
fi

if [ "$RUNTIME" = frankenphp ]; then
    FRANKENPHP_BIN=${GATEWAY_ROUTER_FRANKENPHP_BIN:-frankenphp}
    if ! command -v "$FRANKENPHP_BIN" >/dev/null 2>&1; then
        echo 'A FrankenPHP binary containing the Gateway Caddy module is required.' >&2
        exit 1
    fi
    CADDYFILE="$APP_DIR/Caddyfile"
    if [ -n "${GATEWAY_DELIVERY_DATABASE_URL:-}" ]; then
        CADDYFILE="$APP_DIR/Caddyfile.postgres"
    fi
    exec "$FRANKENPHP_BIN" run --config "$CADDYFILE"
fi

if [ ! -x "$APP_DIR/../vendor/bin/roadrunner-worker" ]; then
    echo "RoadRunner worker is missing from $APP_DIR/../vendor/bin; install Planner dependencies." >&2
    exit 1
fi

OCTANE_BASE_DIR="$DATA_DIR/octane"
umask 077
mkdir -p "$OCTANE_BASE_DIR/.laravel"
php -r '
    $bootstrap = realpath($argv[1]);
    if ($bootstrap === false) {
        fwrite(STDERR, "Router PHP bootstrap is missing.\n");
        exit(1);
    }
    file_put_contents($argv[2], "<?php\n\nreturn require ".var_export($bootstrap, true).";\n");
' "$APP_DIR/bootstrap.php" "$OCTANE_BASE_DIR/.laravel/app.php"

CONFIG_PATH="$DATA_DIR/router.rr.yaml"
php -r '
    $quote = static fn (string $value): string => json_encode($value, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);
    $app = getenv("GATEWAY_ROUTER_APP_DIR");
    $octane = getenv("GATEWAY_ROUTER_DATA_DIR")."/octane";
    $worker = "php ../vendor/bin/roadrunner-worker";
    $config = "version: \"3\"\nserver:\n  command: ".$quote($worker)."\n  env:\n";
    foreach (["APP_BASE_PATH" => $octane, "COMPOSER_VENDOR_DIR" => dirname($app)."/vendor", "LARAVEL_OCTANE" => "1"] as $key => $value) {
        $config .= "    ".$key.": ".$quote($value)."\n";
    }
    foreach ([
        "APP_ENV",
        "APP_KEY",
        "DB_CONNECTION",
        "DB_URL",
        "DB_DATABASE",
        "SESSION_DRIVER",
        "GATEWAY_ROUTER_DATA_DIR",
        "LARAVEL_STORAGE_PATH",
        "APP_SERVICES_CACHE",
        "APP_PACKAGES_CACHE",
        "APP_CONFIG_CACHE",
        "APP_ROUTES_CACHE",
        "APP_EVENTS_CACHE",
        "GATEWAY_PATH_RESOLVER",
        "GATEWAY_INTERNAL_TOKEN",
        "REGISTRY_TOKEN",
        "GATEWAY_PUBLIC_URL",
        "GATEWAY_DELIVERY_ADMIN_URL",
        "GATEWAY_DELIVERY_ADMIN_NODES",
        "GATEWAY_DELIVERY_ADMIN_SHARED_URLS",
        "GATEWAY_DELIVERY_ADMIN_DISCOVERY_ENABLED",
        "GATEWAY_CACHE_STORE",
        "GATEWAY_MUTATION_LOCK_STORE",
        "GATEWAY_EMAIL_HOOK_CLIENT",
        "GATEWAY_EMAIL_PROVIDER_ROUTE_RESOLVER",
        "GATEWAY_EMAIL_OAUTH_REFRESHER",
        "GATEWAY_EMAIL_OAUTH_CALLBACK_URL",
        "GATEWAY_EMAIL_GOOGLE_CLIENT_ID",
        "GATEWAY_EMAIL_GOOGLE_CLIENT_SECRET",
        "GATEWAY_EMAIL_GOOGLE_IMAP_UPSTREAM",
        "GATEWAY_EMAIL_GOOGLE_SMTP_UPSTREAM",
        "GATEWAY_EMAIL_MICROSOFT_CLIENT_ID",
        "GATEWAY_EMAIL_MICROSOFT_CLIENT_SECRET",
        "GATEWAY_EMAIL_MICROSOFT_TENANT",
        "GATEWAY_EMAIL_MICROSOFT_IMAP_UPSTREAM",
        "GATEWAY_EMAIL_MICROSOFT_SMTP_UPSTREAM",
        "GATEWAY_EMAIL_POLICY",
        "GATEWAY_EMAIL_SUBMISSION_AUTHENTICATOR",
        "GATEWAY_EMAIL_SHARED_FROM_ADDRESS",
        "GATEWAY_EMAIL_MANAGED_DKIM_SIGNING_ENABLED",
        "GATEWAY_EMAIL_MANAGED_DKIM_SELECTOR",
        "GATEWAY_EMAIL_MANAGED_SPF_VALUE",
        "GATEWAY_EMAIL_MAILBOX_AUTHENTICATOR",
    ] as $key) {
        $value = getenv($key);
        if ($value !== false && $value !== "") {
            $config .= "    ".$key.": ".$quote($value)."\n";
        }
    }
    $listen = getenv("GATEWAY_ROUTER_LISTEN");
    $workers = (int) getenv("GATEWAY_PLANNER_WORKERS");
    if ($workers < 1) {
        fwrite(STDERR, "GATEWAY_PLANNER_WORKERS must be positive.\n");
        exit(1);
    }
    $maxRequests = (int) getenv("GATEWAY_PLANNER_MAX_REQUESTS");
    if ($maxRequests < 1) {
        fwrite(STDERR, "GATEWAY_PLANNER_MAX_REQUESTS must be positive.\n");
        exit(1);
    }
    $config .= "http:\n  address: ".$quote($listen)."\n";
    if (($tlsListen = getenv("GATEWAY_ROUTER_TLS_LISTEN")) !== false && $tlsListen !== "") {
        $config .= "  ssl:\n    address: ".$quote($tlsListen)."\n    redirect: false\n".
            "    cert: ".$quote(getenv("GATEWAY_ROUTER_TLS_CERT_FILE"))."\n".
            "    key: ".$quote(getenv("GATEWAY_ROUTER_TLS_KEY_FILE"))."\n";
    }
    $config .= "  middleware: [\"gateway\", \"gzip\"]\n  max_request_size: 10\n  pool:\n    num_workers: ".$workers."\n    max_jobs: ".$maxRequests."\nlogs:\n  level: \"info\"\n";
    file_put_contents($argv[1], $config);
' "$CONFIG_PATH"

unset GATEWAY_RUNTIME
export ROADRUNNER_CONFIG="$CONFIG_PATH"

if [ -n "${GATEWAY_ROUTER_ROADRUNNER_BIN:-}" ]; then
    if [ ! -x "$GATEWAY_ROUTER_ROADRUNNER_BIN" ]; then
        echo "RoadRunner Router binary is not executable: $GATEWAY_ROUTER_ROADRUNNER_BIN" >&2
        exit 1
    fi
    cd "$APP_DIR"
    exec "$GATEWAY_ROUTER_ROADRUNNER_BIN"
fi

REPO_DIR=$(CDPATH= cd -- "$APP_DIR/.." && pwd)
if ! command -v go >/dev/null 2>&1; then
    echo 'Go is required to build Router; alternatively set GATEWAY_ROUTER_ROADRUNNER_BIN.' >&2
    exit 1
fi
GOTELEMETRY=off go -C "$REPO_DIR/pkg/roadrunner/cmd/router" build -mod=mod -o "$DATA_DIR/gateway-router-roadrunner" .
cd "$APP_DIR"
exec "$DATA_DIR/gateway-router-roadrunner"
