#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
TEST_DIR=$(mktemp -d "${TMPDIR:-/tmp}/gateway-adapter-package.XXXXXX")
trap 'rm -rf "$TEST_DIR"' EXIT
mkdir -p "$TEST_DIR/output" "$TEST_DIR/unpacked"

COMPOSER_ROOT_VERSION=dev-main composer --working-dir="$ROOT/mod/adapter" \
    --no-plugins --no-scripts archive --format=tar --file=gateway-adapter \
    --dir="$TEST_DIR/output" --no-interaction

tar -xf "$TEST_DIR/output/gateway-adapter.tar" -C "$TEST_DIR/unpacked"

test -f "$TEST_DIR/unpacked/composer.json"
test -f "$TEST_DIR/unpacked/src/Contract/RoutePlanner.php"
test -f "$TEST_DIR/unpacked/src/Protocol/RoutePlan.php"
test ! -e "$TEST_DIR/unpacked/src/GatewayServiceProvider.php"

php -r '
$manifest = json_decode(file_get_contents($argv[1]."/composer.json"), true, flags: JSON_THROW_ON_ERROR);
if (($manifest["name"] ?? null) !== "webong/gateway-adapter") {
    throw new RuntimeException("Unexpected Gateway adapter package name.");
}
if (isset($manifest["require"]["laravel/framework"]) || isset($manifest["require"]["symfony/framework-bundle"])) {
    throw new RuntimeException("Gateway adapter must remain framework-neutral.");
}
' "$TEST_DIR/unpacked"

printf 'Gateway adapter archive contains only its framework-neutral package.\n'
