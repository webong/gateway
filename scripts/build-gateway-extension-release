#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
OUTPUT=${1:-"$ROOT/dist/gateway-extension-release"}
VERSION=${2:-}
if [[ -z "$VERSION" ]]; then
    echo "Usage: $0 [output-directory] vMAJOR.MINOR.PATCH" >&2
    exit 2
fi
case "$OUTPUT" in
    /*) ;;
    *) OUTPUT="$(pwd)/$OUTPUT" ;;
esac
if [[ -e "$OUTPUT" ]]; then
    echo "Output already exists: $OUTPUT" >&2
    exit 1
fi
mkdir -p "$(dirname -- "$OUTPUT")"
STAGE=$(mktemp -d "${OUTPUT}.tmp.XXXXXX")
trap 'rm -rf -- "$STAGE"' EXIT

for platform in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64; do
    os=${platform%/*}
    arch=${platform#*/}
    mkdir -p "$STAGE/$platform"
    for extension in centrifugo mercure reverb; do
        echo "Building $extension for $platform"
        GOTELEMETRY=off CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" \
            go -C "$ROOT" build -mod=readonly -trimpath \
            -o "$STAGE/$platform/gateway-$extension" "./pkg/$extension/cmd/plugin"
    done
done

GOTELEMETRY=off go -C "$ROOT" run -mod=readonly ./pkg/spinner/cmd/gateway-extension \
    catalog --layout platform --dir "$STAGE" --version "$VERSION" >/dev/null
mv "$STAGE" "$OUTPUT"
trap - EXIT
echo "Gateway extension release bundle: $OUTPUT"
