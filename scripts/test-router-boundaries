#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for extension in frankenphp roadrunner; do
dependencies=$(GOWORK=off go -C "$ROOT/pkg/$extension" list -mod=readonly -deps ./runtime)
if grep -q '^github.com/webong/gateway/pkg/spinner\($\|/\)' <<<"$dependencies"; then
    echo "$extension must not depend on Spinner." >&2
    exit 1
fi
modules=$(GOWORK=off go -C "$ROOT/pkg/$extension" list -mod=readonly -m all)
if grep -q '^github.com/webong/gateway ' <<<"$modules"; then
    echo "$extension must not require the Gateway core module." >&2
    exit 1
fi
echo "$extension has no Spinner implementation or Gateway core dependency."
done

dependencies=$(GOWORK=off go -C "$ROOT/mod/arranger" list -mod=readonly -deps ./router)
if grep -q '^github.com/webong/gateway/pkg/spinner\($\|/\)\|^github.com/roadrunner-server/' <<<"$dependencies"; then
    echo 'Arranger Router policy must not depend on Spinner or RoadRunner.' >&2
    exit 1
fi
echo 'Arranger Router policy has no Spinner or RoadRunner dependency.'

dependencies=$(GOWORK=off go -C "$ROOT/pkg/spinner" list -mod=readonly -deps ./...)
if grep -q '^github.com/roadrunner-server/\|^github.com/webong/gateway/pkg/roadrunner\($\|/\)' <<<"$dependencies"; then
    echo 'Standalone Spinner must not depend on RoadRunner.' >&2
    exit 1
fi
echo 'Standalone Spinner has no RoadRunner dependency.'
