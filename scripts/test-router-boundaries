#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
dependencies=$(go -C "$ROOT/ext/frankenphp" list -mod=readonly -deps ./runtime)
if grep -q '^github.com/webong/gateway/src/spinner\($\|/\)' <<<"$dependencies"; then
    echo 'FrankenPHP must not depend on Spinner.' >&2
    exit 1
fi
modules=$(go -C "$ROOT/ext/frankenphp" list -mod=readonly -m all)
if grep -q '^github.com/webong/gateway ' <<<"$modules"; then
    echo 'FrankenPHP must not require the Gateway core module.' >&2
    exit 1
fi
echo 'FrankenPHP has no Spinner implementation or Gateway core dependency.'
