#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for extension in frankenphp roadrunner; do
dependencies=$(go -C "$ROOT/ext/$extension" list -mod=readonly -deps ./runtime)
if grep -q '^github.com/webong/gateway/src/spinner\($\|/\)' <<<"$dependencies"; then
    echo "$extension must not depend on Spinner." >&2
    exit 1
fi
modules=$(go -C "$ROOT/ext/$extension" list -mod=readonly -m all)
if grep -q '^github.com/webong/gateway ' <<<"$modules"; then
    echo "$extension must not require the Gateway core module." >&2
    exit 1
fi
echo "$extension has no Spinner implementation or Gateway core dependency."
done

dependencies=$(go -C "$ROOT" list -mod=readonly -deps ./lib/router)
if grep -q '^github.com/roadrunner-server/\|^github.com/webong/gateway/ext/roadrunner\($\|/\)' <<<"$dependencies"; then
    echo 'Shared Router library must not depend on RoadRunner.' >&2
    exit 1
fi
echo 'Shared Router library has no RoadRunner dependency.'

dependencies=$(go -C "$ROOT" list -mod=readonly -deps ./src/spinner/...)
if grep -q '^github.com/roadrunner-server/\|^github.com/webong/gateway/ext/roadrunner\($\|/\)' <<<"$dependencies"; then
    echo 'Standalone Spinner must not depend on RoadRunner.' >&2
    exit 1
fi
echo 'Standalone Spinner has no RoadRunner dependency.'
