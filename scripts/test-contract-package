#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
TEST_DIR=$(mktemp -d "${TMPDIR:-/tmp}/gateway-contract-package.XXXXXX")
trap 'rm -rf -- "$TEST_DIR"' EXIT

cp -R "$ROOT/mod/adapter/." "$TEST_DIR/"
composer --working-dir="$TEST_DIR" dump-autoload --no-plugins --no-scripts --no-interaction --quiet
php -r '
require $argv[1]."/vendor/autoload.php";
$automation = new Webong\Gateway\Protocols\Automation("example", "run()");
if ($automation->language !== "example"
    || Webong\Gateway\Contracts\AutomationExecutionTarget::SPINNER->value !== "spinner") {
    throw new RuntimeException("Contract package consumer failed.");
}
' "$TEST_DIR"

printf 'PHP contract package loads without Planner or Laravel.\n'
