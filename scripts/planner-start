#!/bin/sh
set -eu

if [ -z "${APP_KEY:-}" ] || [ -z "${GATEWAY_INTERNAL_TOKEN:-}" ] || [ -z "${REGISTRY_TOKEN:-}" ]; then
    echo 'APP_KEY, GATEWAY_INTERNAL_TOKEN, and REGISTRY_TOKEN are required.' >&2
    exit 1
fi
if [ "${DB_CONNECTION:-}" != pgsql ] || [ -z "${DB_URL:-}" ]; then
    echo 'Standalone Planner requires DB_CONNECTION=pgsql and DB_URL.' >&2
    exit 1
fi

DATA_DIR=${GATEWAY_ROUTER_DATA_DIR:-/data/planner}
APP_DIR=${GATEWAY_PLANNER_APP_DIR:-/gateway/app}
mkdir -p "$DATA_DIR/cache" "$DATA_DIR/storage/framework/cache/data" \
    "$DATA_DIR/storage/framework/sessions" "$DATA_DIR/storage/framework/views"
mkdir -p "$DATA_DIR/storage/logs"
export GATEWAY_ROUTER_DATA_DIR="$DATA_DIR"
export LARAVEL_STORAGE_PATH="$DATA_DIR/storage"
export COMPOSER_VENDOR_DIR=${COMPOSER_VENDOR_DIR:-/gateway/vendor}
export APP_SERVICES_CACHE="$DATA_DIR/cache/services.php"
export APP_PACKAGES_CACHE="$DATA_DIR/cache/packages.php"
export APP_CONFIG_CACHE="$DATA_DIR/cache/config.php"
export APP_ROUTES_CACHE="$DATA_DIR/cache/routes-v7.php"
export APP_EVENTS_CACHE="$DATA_DIR/cache/events.php"

migrate_gateway_schema() {
    if [ "${GATEWAY_MIGRATIONS_ADOPT_EXISTING:-false}" = true ]; then
        php "$APP_DIR/artisan" gateway:migrate --adopt-existing
    else
        php "$APP_DIR/artisan" gateway:migrate
    fi
}

case "${1:-serve}" in
    migrate)
        migrate_gateway_schema
        php "$APP_DIR/artisan" migrate --realpath \
            --path=/gateway/vendor/webong/proxy/database/migrations --force
        exec php "$APP_DIR/artisan" migrate --force
        ;;
    serve)
        SERVER=${GATEWAY_PLANNER_SERVER:-frankenphp}
        HOST=${GATEWAY_PLANNER_HOST:-0.0.0.0}
        PORT=${GATEWAY_PLANNER_PORT:-8080}
        WORKERS=${GATEWAY_PLANNER_WORKERS:-auto}
        MAX_REQUESTS=${GATEWAY_PLANNER_MAX_REQUESTS:-500}

        case "$SERVER" in
            fpm)
                if ! command -v php-fpm >/dev/null 2>&1; then
                    echo 'PHP-FPM requires the php-fpm executable.' >&2
                    exit 1
                fi
                if ! command -v caddy >/dev/null 2>&1; then
                    echo 'PHP-FPM hosting requires the caddy executable.' >&2
                    exit 1
                fi
                ;;
            frankenphp)
                if ! command -v frankenphp >/dev/null 2>&1; then
                    echo 'Octane/FrankenPHP requires the frankenphp executable.' >&2
                    exit 1
                fi
                ;;
            swoole)
                if ! php -r 'exit(extension_loaded("swoole") || extension_loaded("openswoole") ? 0 : 1);'; then
                    echo 'Octane/Swoole requires the swoole or openswoole PHP extension.' >&2
                    exit 1
                fi
                ;;
            roadrunner)
                if [ ! -x "$APP_DIR/rr" ] && ! command -v rr >/dev/null 2>&1; then
                    echo 'Octane/RoadRunner requires the rr executable.' >&2
                    exit 1
                fi
                ;;
            workerman)
                if ! php -r "require '$COMPOSER_VENDOR_DIR/autoload.php'; exit(class_exists('Workerman\\Worker') ? 0 : 1);"; then
                    echo 'Workerman hosting requires workerman/workerman.' >&2
                    exit 1
                fi
                ;;
            *)
                echo 'GATEWAY_PLANNER_SERVER must be fpm, frankenphp, swoole, roadrunner, or workerman.' >&2
                exit 2
                ;;
        esac

        migrate_gateway_schema
        php "$APP_DIR/artisan" migrate --realpath \
            --path=/gateway/vendor/webong/proxy/database/migrations --force
        php "$APP_DIR/artisan" migrate --force

        if [ "$SERVER" = workerman ]; then
            # Workerman stops immediately on SIGTERM and SIGINT, which is what
            # `docker stop` and Kubernetes send, and drains in-flight requests only
            # on SIGQUIT. Keep this script as the container's entrypoint and
            # translate those stop signals into SIGQUIT, so a stop lets requests
            # finish. The master's own exit status becomes ours.
            php "$APP_DIR/workerman.php" start &
            WORKERMAN_PID=$!
            trap 'kill -QUIT "$WORKERMAN_PID" 2>/dev/null || true' TERM INT
            while :; do
                status=0
                wait "$WORKERMAN_PID" || status=$?
                # `wait` also returns when a trapped signal arrives; only leave
                # once the master has really exited.
                kill -0 "$WORKERMAN_PID" 2>/dev/null || break
            done
            trap - TERM INT
            exit "$status"
        fi

        if [ "$SERVER" = fpm ]; then
            export GATEWAY_PLANNER_APP_DIR="$APP_DIR"
            php-fpm --nodaemonize --fpm-config \
                "${GATEWAY_PLANNER_FPM_CONFIG:-/etc/php-fpm.d/gateway.conf}" &
            FPM_PID=$!
            CADDY_PID=

            shutdown_fpm_stack() {
                trap - EXIT INT TERM
                if [ -n "$CADDY_PID" ]; then
                    kill -TERM "$CADDY_PID" 2>/dev/null || true
                    wait "$CADDY_PID" 2>/dev/null || true
                fi
                kill -TERM "$FPM_PID" 2>/dev/null || true
                wait "$FPM_PID" 2>/dev/null || true
            }
            trap 'status=$?; shutdown_fpm_stack; exit "$status"' EXIT
            trap 'exit 143' TERM
            trap 'exit 130' INT

            attempts=0
            until php -r '$socket = @fsockopen("127.0.0.1", 9000); if ($socket === false) { exit(1); } fclose($socket);'; do
                if ! kill -0 "$FPM_PID" 2>/dev/null; then
                    wait "$FPM_PID"
                    exit $?
                fi
                attempts=$((attempts + 1))
                if [ "$attempts" -ge 50 ]; then
                    echo 'PHP-FPM did not become ready on 127.0.0.1:9000.' >&2
                    exit 1
                fi
                sleep 0.1
            done
            caddy run --config \
                "${GATEWAY_PLANNER_FPM_CADDYFILE:-/etc/caddy/Caddyfile.fpm}" \
                --adapter caddyfile &
            CADDY_PID=$!

            while kill -0 "$FPM_PID" 2>/dev/null \
                && kill -0 "$CADDY_PID" 2>/dev/null; do
                sleep 1
            done

            if ! kill -0 "$FPM_PID" 2>/dev/null; then
                if wait "$FPM_PID"; then
                    status=1
                else
                    status=$?
                fi
                echo "PHP-FPM exited; stopping the Planner frontend." >&2
                exit "$status"
            fi

            if wait "$CADDY_PID"; then
                status=1
            else
                status=$?
            fi
            echo "Caddy exited; stopping PHP-FPM." >&2
            exit "$status"
        fi

        set -- php "$APP_DIR/artisan" octane:start \
            "--server=$SERVER" "--host=$HOST" "--port=$PORT" \
            "--workers=$WORKERS" "--max-requests=$MAX_REQUESTS"
        case "$SERVER" in
            frankenphp)
                set -- "$@" \
                    "--admin-port=${GATEWAY_PLANNER_ADMIN_PORT:-2019}"
                ;;
            roadrunner)
                RR_CONFIG="$DATA_DIR/octane.rr.yaml"
                if [ ! -f "$RR_CONFIG" ]; then
                    printf 'version: "3"\n' > "$RR_CONFIG"
                fi
                set -- "$@" \
                    "--rpc-host=${GATEWAY_PLANNER_RPC_HOST:-127.0.0.1}" \
                    "--rpc-port=${GATEWAY_PLANNER_RPC_PORT:-6001}" \
                    "--rr-config=$RR_CONFIG"
                ;;
        esac
        exec "$@"
        ;;
    *)
        echo 'Usage: gateway-planner-start [migrate|serve]' >&2
        exit 2
        ;;
esac
