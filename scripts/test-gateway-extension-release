#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [[ $# -lt 2 || $# -gt 3 ]]; then
    echo "Usage: $0 BUNDLE_DIRECTORY vMAJOR.MINOR.PATCH [LOCAL_LINUX_TEST_IMAGE]" >&2
    exit 2
fi
BUNDLE=$(CDPATH= cd -- "$1" && pwd)
VERSION=$2
IMAGE=${3:-python:3.12-slim-bookworm}

catalog_args=(list --catalog "$BUNDLE/catalog.json")
if [[ -n "${GATEWAY_EXTENSION_TEST_PUBLIC_KEY:-}" ]]; then
    catalog_args+=(--public-key "$GATEWAY_EXTENSION_TEST_PUBLIC_KEY")
fi
GOTELEMETRY=off go -C "$ROOT" run -mod=readonly ./pkg/spinner/cmd/gateway-extension "${catalog_args[@]}" >/dev/null

python3 - "$BUNDLE" "$VERSION" <<'PY'
import hashlib
import json
import pathlib
import sys

bundle = pathlib.Path(sys.argv[1])
version = sys.argv[2]
catalog = json.loads((bundle / "catalog.json").read_bytes())
expected = {
    (name, os_name, arch)
    for name in ("centrifugo", "mercure", "reverb")
    for os_name in ("linux", "darwin")
    for arch in ("amd64", "arm64")
}
found = set()
for artifact in catalog["artifacts"]:
    identity = (artifact["name"], artifact["os"], artifact["arch"])
    if identity not in expected or identity in found:
        raise SystemExit(f"unexpected or duplicate release artifact: {identity}")
    found.add(identity)
    if artifact["version"] != version:
        raise SystemExit(f"wrong release version: {identity}")
    expected_url = f"{artifact['os']}/{artifact['arch']}/gateway-{artifact['name']}"
    if artifact["url"] != expected_url:
        raise SystemExit(f"wrong release artifact path: {identity}")
    with (bundle / expected_url).open("rb") as binary:
        digest = hashlib.sha256()
        for chunk in iter(lambda: binary.read(1024 * 1024), b""):
            digest.update(chunk)
    if digest.hexdigest() != artifact["sha256"]:
        raise SystemExit(f"release artifact digest mismatch: {identity}")
if found != expected:
    raise SystemExit(f"missing release artifacts: {sorted(expected - found)}")
print("Verified 12 release artifact paths and SHA-256 digests")
PY

if [[ "$(uname -s)" != Darwin ]]; then
    echo "Darwin runtime validation requires a macOS host" >&2
    exit 2
fi

image_arch=$(docker image inspect --format '{{.Architecture}}' "$IMAGE")
case "$image_arch" in
    amd64|arm64) ;;
    *) echo "Unsupported local Linux test image architecture: $image_arch" >&2; exit 2 ;;
esac

request='{"version":1,"id":1,"method":"describe"}'
for platform in darwin/amd64 darwin/arm64 linux/amd64 linux/arm64; do
    os_name=${platform%/*}
    for extension in centrifugo mercure reverb; do
        if [[ "$os_name" == darwin ]]; then
            response=$(printf '%s\n' "$request" | "$BUNDLE/$platform/gateway-$extension")
        else
            response=$(printf '%s\n' "$request" | docker run --rm -i --pull never \
                --platform "linux/$image_arch" --network none --read-only \
                --security-opt no-new-privileges --cap-drop ALL \
                --mount "type=bind,src=$BUNDLE/$platform,dst=/extensions,readonly" \
                --entrypoint "/extensions/gateway-$extension" "$IMAGE")
        fi
        python3 - "$extension" "$platform" "$response" <<'PY'
import json
import sys

expected_type, platform, raw = sys.argv[1:]
try:
    response = json.loads(raw)
except json.JSONDecodeError as error:
    raise SystemExit(f"invalid describe response for {expected_type} on {platform}: {error}")
if (
    response.get("version") != 1
    or response.get("id") != 1
    or response.get("type") != expected_type
    or response.get("error")
    or not isinstance(response.get("drivers"), list)
    or not response["drivers"]
):
    raise SystemExit(f"bad describe response for {expected_type} on {platform}: {response}")
print(f"Passed {expected_type} describe on {platform}")
PY
    done
done
