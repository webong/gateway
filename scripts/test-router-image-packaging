#!/usr/bin/env bash

set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
WORKSPACE_VERSION=$(awk '$1 == "go" { print $2; exit }' "$ROOT/go.work")

if [ -z "$WORKSPACE_VERSION" ]; then
    echo 'go.work does not declare a Go version.' >&2
    exit 1
fi

# Official Go image tags omit a trailing patch zero (1.26.0 -> 1.26).
IMAGE_VERSION=${WORKSPACE_VERSION%.0}
EXPECTED="FROM golang:${IMAGE_VERSION}-alpine AS router-builder"
DOCKERFILE="$ROOT/infra/docker/RoadRunner.router.Dockerfile"
LIBRARY_DOCKERFILE="$ROOT/infra/docker/Gateway.router.Dockerfile"

for router_dockerfile in "$DOCKERFILE" "$LIBRARY_DOCKERFILE"; do
    if grep -Eq '^USER[[:space:]]+www-data$' "$router_dockerfile"; then
        echo "Router must start through its data-migration entrypoint before dropping privileges: $router_dockerfile" >&2
        exit 1
    fi
    if ! grep -Fq 'ENTRYPOINT ["/gateway/scripts/router-container-entrypoint"' "$router_dockerfile"; then
        echo "Router image is missing its upgrade-safe container entrypoint: $router_dockerfile" >&2
        exit 1
    fi
done

if ! grep -Fq 'gosu ' "$LIBRARY_DOCKERFILE" || ! grep -Fq 'su-exec ' "$DOCKERFILE"; then
    echo 'Router images must install the privilege-drop helper used by their base distribution.' >&2
    exit 1
fi

if grep -Eq '^replace[[:space:]]+github\.com/webong/gateway/arranger' "$ROOT/go.work"; then
    echo 'go.work must not replace Arranger because it is already a workspace module.' >&2
    exit 1
fi

if ! grep -Fx "$EXPECTED" "$DOCKERFILE" >/dev/null; then
    echo "RoadRunner Router must build with the go.work toolchain: $EXPECTED" >&2
    exit 1
fi

if ! grep -Fx 'FROM php:8.4-cli-alpine AS php-base' "$DOCKERFILE" >/dev/null; then
    echo 'RoadRunner Router must use the Alpine PHP runtime.' >&2
    exit 1
fi

if ! grep -Fq -- '-ldflags="-s -w"' "$DOCKERFILE"; then
    echo 'RoadRunner Router binary must omit symbol and debug tables.' >&2
    exit 1
fi

if grep -Fq 'COPY --from=planner-builder /src/gateway /gateway' "$DOCKERFILE"; then
    echo 'RoadRunner Router must not copy the complete build workspace into the runtime image.' >&2
    exit 1
fi

if ! grep -Fq 'GATEWAY_COMPANION_PHP_BINARY=/usr/local/bin/php' "$LIBRARY_DOCKERFILE"; then
    echo 'The FrankenPHP library Router must name its bundled PHP CLI for dynamic companions.' >&2
    exit 1
fi

for router_dockerfile in "$DOCKERFILE" "$LIBRARY_DOCKERFILE"; do
    if ! grep -Fq 'GATEWAY_PLUGIN_DIR=/data/spinner-extensions' "$router_dockerfile" \
        || ! grep -Fq 'GATEWAY_COMPANION_PLUGIN_DIR=/data/planner-extensions' "$router_dockerfile"; then
        echo "The bundled Router must keep Spinner and Planner extension stores separate: $router_dockerfile" >&2
        exit 1
    fi
done

if grep -Fq "env('GATEWAY_COMPANION_PLUGIN_DIR', env('GATEWAY_PLUGIN_DIR'" \
    "$ROOT/pkg/planner/config/gateway.php"; then
    echo 'Planner must not fall back to Spinner extension storage.' >&2
    exit 1
fi

if ! grep -Fxq 'opcache.enable_cli=0' "$ROOT/infra/docker/router.php.ini"; then
    echo 'The bundled PHP CLI must not build a per-invocation OPcache for companion processes.' >&2
    exit 1
fi

for runtime_path in app pkg vendor; do
    if ! grep -Fq "COPY --from=planner-builder /src/gateway/$runtime_path /gateway/$runtime_path" "$DOCKERFILE"; then
        echo "RoadRunner Router runtime is missing $runtime_path." >&2
        exit 1
    fi
done

php -r '
    $root = $argv[1];
    $manifest = json_decode(file_get_contents($root."/app/composer.json"), true, flags: JSON_THROW_ON_ERROR);
    $repositories = array_column($manifest["repositories"] ?? [], "url");
    foreach (["planner", "web", "dns", "email", "database"] as $directory) {
        if (! in_array("../pkg/".$directory, $repositories, true)) {
            fwrite(STDERR, "Planner host is missing the local package repository [".$directory."].\n");
            exit(1);
        }
    }
    $includes = $manifest["extra"]["merge-plugin"]["include"] ?? [];
    if (in_array("../pkg/*/composer.json", $includes, true) || in_array("../pkg/planner/composer.json", $includes, true)) {
        fwrite(STDERR, "Planner must be installed as a package, not merged as an extension.\n");
        exit(1);
    }
    $lock = json_decode(file_get_contents($root."/app/composer.lock"), true, flags: JSON_THROW_ON_ERROR);
    $coreFound = false;
    $localPackages = [
        "webong/gateway-planner" => "../pkg/planner",
        "webong/web" => "../pkg/web",
        "webong/dns" => "../pkg/dns",
        "webong/email" => "../pkg/email",
        "webong/database" => "../pkg/database",
    ];
    foreach ($lock["packages"] ?? [] as $package) {
        if (($package["name"] ?? null) === "webong/gateway") {
            $autoload = $package["autoload"]["psr-4"] ?? [];
            if (($autoload["Webong\\Gateway\\Companion\\"] ?? null) !== "mod/adapter/src/Companion/"
                || ($autoload["Webong\\Gateway\\Contracts\\"] ?? null) !== "mod/adapter/src/Contract/"
                || ($autoload["Webong\\Gateway\\Protocols\\"] ?? null) !== "mod/adapter/src/Protocol/") {
                fwrite(STDERR, "Locked Gateway core autoload does not match mod/adapter.\n");
                exit(1);
            }
            $coreFound = true;
        }
        $name = $package["name"] ?? null;
        if (is_string($name) && isset($localPackages[$name])) {
            if (($package["dist"]["url"] ?? null) !== $localPackages[$name]) {
                fwrite(STDERR, "Locked package path for [".$name."] does not match app/composer.json.\n");
                exit(1);
            }
            unset($localPackages[$name]);
        }
    }
    if (! $coreFound || $localPackages !== []) {
        fwrite(STDERR, "app/composer.lock is missing a required local Gateway package.\n");
        exit(1);
    }
' "$ROOT"

if grep -Fq 'composer install --working-dir=/src/gateway/pkg/hookscript/companion' "$LIBRARY_DOCKERFILE"; then
    echo 'The FrankenPHP library Router must not preinstall the HookScript companion.' >&2
    exit 1
fi

composer validate --working-dir="$ROOT/pkg/hookscript/companion" --no-check-publish --strict >/dev/null

composer validate --working-dir="$ROOT/app" --no-check-publish --strict >/dev/null

if grep -R -n -E 'Webong\\Gateway\\(Contract|Protocol)\\' \
    "$ROOT/app" --include='*.php' --exclude-dir=vendor; then
    echo 'Bundled Planner host still references a singular Gateway namespace.' >&2
    exit 1
fi

echo "RoadRunner Router packaging uses Go ${IMAGE_VERSION} and the current Planner module."
