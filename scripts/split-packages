#!/usr/bin/env php
<?php

declare(strict_types=1);

// Invocation compatibility only. Splitting, versioning and metadata belong to the plugin.
$project = dirname(__DIR__);
$arguments = array_slice($argv, 1);
$callerDirectory = getcwd();
$absolutePath = static fn (string $path): string => $path === '' || str_starts_with($path, DIRECTORY_SEPARATOR)
    ? $path : $callerDirectory.DIRECTORY_SEPARATOR.$path;
foreach ($arguments as $index => $argument) {
    if ($argument === '--version') {
        $arguments[$index] = '--release-version';
    } elseif (str_starts_with($argument, '--version=')) {
        $arguments[$index] = '--release-version='.substr($argument, strlen('--version='));
    }
}
// Composer changes cwd before reading command options. Preserve caller-relative paths.
foreach ($arguments as $index => $argument) {
    foreach (['repo', 'out-dir'] as $option) {
        if ($argument === '--'.$option && isset($arguments[$index + 1])) {
            $arguments[$index + 1] = $absolutePath($arguments[$index + 1]);
        } elseif (str_starts_with($argument, '--'.$option.'=')) {
            $arguments[$index] = '--'.$option.'='.$absolutePath(substr($argument, strlen('--'.$option.'=')));
        }
    }
}
$hasRepo = false;
foreach ($arguments as $argument) {
    $hasRepo = $hasRepo || $argument === '--repo' || str_starts_with($argument, '--repo=');
}
if (! $hasRepo) {
    $arguments[] = '--repo='.$callerDirectory;
}
$command = array_merge(
    ['composer', '--no-interaction', '--working-dir='.$project, 'source:publish',
        '--ref-names=short', '--metadata-alias=packages.json'],
    $arguments,
);
$process = proc_open($command, [STDIN, STDOUT, STDERR], $pipes);
if (! is_resource($process)) {
    fwrite(STDERR, "Could not start Composer.\n");
    exit(1);
}
exit(proc_close($process));
