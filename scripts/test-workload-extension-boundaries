#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
for entrypoint in cmd/gateway pkg/spinner/proxy pkg/spinner/cmd/provision; do
    if [[ "$entrypoint" == cmd/* ]]; then
        dependencies=$(GOWORK=off go -C "$ROOT" list -mod=readonly -deps "./$entrypoint")
    else
        dependencies=$(GOWORK=off go -C "$ROOT/pkg/spinner" list -mod=readonly -deps "./${entrypoint#pkg/spinner/}")
    fi
    if grep -Eq '^github\.com/webong/gateway/pkg/(centrifugo|mercure|reverb)/runtime$' <<<"$dependencies"; then
        echo "$entrypoint imports a server workload implementation." >&2
        exit 1
    fi
done
echo 'Spinner entrypoints have no compiled server workload imports.'
