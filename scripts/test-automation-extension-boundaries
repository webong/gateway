#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
GO_BUILD_FLAGS=${GOFLAGS:--mod=mod}

if ! php -r '
    $composer = json_decode(file_get_contents($argv[1]), true, flags: JSON_THROW_ON_ERROR);
    $includes = $composer["extra"]["merge-plugin"]["include"] ?? [];
    exit(in_array("pkg/*/composer.json", $includes, true) ? 0 : 1);
' "$ROOT/composer.json"; then
    echo 'The root Composer project must discover extension-owned manifests through Composer Merge Plugin.' >&2
    exit 1
fi

if rg -n 'pkg/(javascript|lua|webhookscript)/(php/)?src' "$ROOT/composer.json" >/dev/null; then
    echo 'The root Composer project duplicates extension autoload mappings instead of discovering their manifests.' >&2
    exit 1
fi

for extension in javascript lua shell golang php hookscript; do
    package="github.com/webong/gateway/pkg/$extension/runtime"
    dependencies=$(cd "$ROOT/pkg/$extension" && GOWORK=off GOFLAGS="$GO_BUILD_FLAGS" go list -deps ./runtime)
    if grep -q '^github.com/webong/gateway/pkg/spinner\($\|/\)' <<<"$dependencies"; then
        echo "$package depends on Spinner; automation extensions may depend only on Driver contracts." >&2
        exit 1
    fi
    if ! grep -qx 'github.com/webong/gateway/driver/automation' <<<"$dependencies"; then
        echo "$package does not use the public Driver automation interface." >&2
        exit 1
    fi
done

for host in \
    "$ROOT/pkg/spinner/cmd/gateway" \
    "$ROOT/pkg/frankenphp/cmd/router" \
    "$ROOT/pkg/roadrunner/cmd/router"
do
    dependencies=$(cd "$host" && GOWORK=off GOFLAGS="$GO_BUILD_FLAGS" go list -deps .)
    if grep -Eq '^github\.com/webong/gateway/pkg/(golang|hookscript|javascript|lua|php|shell)/runtime$' <<<"$dependencies"; then
        echo "$host compiles a concrete automation extension." >&2
        exit 1
    fi
    if grep -Eq 'github\.com/webong/gateway/pkg/(golang|hookscript|javascript|lua|php|shell)([[:space:]]|$)' "$host/go.mod"; then
        echo "$host still names a concrete automation extension module." >&2
        exit 1
    fi
done

for extension in javascript lua shell golang php; do
    if [[ ! -f "$ROOT/pkg/$extension/extension.json" || ! -f "$ROOT/pkg/$extension/cmd/spinner/main.go" ]]; then
        echo "$extension does not provide an installable Spinner extension entrypoint." >&2
        exit 1
    fi
done

if ! php -r '
    $composer = json_decode(file_get_contents($argv[1]), true, flags: JSON_THROW_ON_ERROR);
    $includes = $composer["extra"]["merge-plugin"]["include"] ?? [];
    $automation = ["hookscript", "javascript", "lua", "shell"];
    foreach ($automation as $name) {
        if (in_array("../pkg/{$name}/composer.json", $includes, true)) exit(1);
    }
' "$ROOT/app/composer.json"; then
    echo 'The production Planner host statically merges an installable automation extension.' >&2
    exit 1
fi

if rg -n '^(use|extends|implements).*Illuminate\\' "$ROOT/mod/adapter/src" >/dev/null; then
    echo 'mod/adapter depends on Laravel; shared PHP contracts must remain framework-free.' >&2
    exit 1
fi

echo 'Automation extensions are installable guests; Gateway hosts compile no concrete automation runtimes.'
