#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
shopt -s nullglob
runtime_dirs=("$ROOT"/pkg/*/runtime)

if (( ${#runtime_dirs[@]} == 0 )); then
    echo 'No extension runtime packages found.' >&2
    exit 1
fi

for runtime_dir in "${runtime_dirs[@]}"; do
    extension=$(basename -- "$(dirname -- "$runtime_dir")")
    module_file="$ROOT/pkg/$extension/go.mod"
    if [[ ! -f "$module_file" ]]; then
        echo "Runtime extension pkg/$extension must own a go.mod." >&2
        exit 1
    fi

    expected="github.com/webong/gateway/pkg/$extension"
    actual=$(GOWORK=off go -C "$ROOT/pkg/$extension" list -mod=readonly -m -f '{{.Path}}')
    if [[ "$actual" != "$expected" ]]; then
        echo "Unexpected pkg/$extension module path: $actual (want $expected)" >&2
        exit 1
    fi

    echo "pkg/$extension owns module $actual."
done
