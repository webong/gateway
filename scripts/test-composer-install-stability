#!/usr/bin/env bash
# A fresh checkout must install from composer.lock without changing it.
#
# Copy the workspace into a clean directory and verify the lock is byte-identical
# while workspace extension namespaces remain autoloadable. Needs network access
# to Packagist and GitHub.
set -euo pipefail
export LC_ALL=C

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
TEST_DIR=$(mktemp -d "${TMPDIR:-/tmp}/gateway-composer-install.XXXXXX")
trap 'rm -rf -- "$TEST_DIR"' EXIT

for tool in composer php; do
    command -v "$tool" >/dev/null || { echo "$tool is required." >&2; exit 1; }
done

mkdir -p "$TEST_DIR/scripts" "$TEST_DIR/mod"
cp "$ROOT/composer.json" "$ROOT/composer.lock" "$TEST_DIR/"
cp "$ROOT/scripts/composer-install" "$TEST_DIR/scripts/"
cp -R "$ROOT/mod/adapter" "$TEST_DIR/mod/adapter"
cp -R "$ROOT/mod/builder" "$TEST_DIR/mod/builder"
for manifest in "$ROOT"/pkg/*/composer.json; do
    directory=$TEST_DIR/pkg/$(basename "$(dirname "$manifest")")
    mkdir -p "$directory"
    # Include working tree source files, including new files awaiting commit.
    package_path=pkg/$(basename "$(dirname "$manifest")")
    (cd "$ROOT" && rg --files --hidden "$package_path") | tar -C "$ROOT" -cf - -T - | tar -C "$TEST_DIR" -xf -
done

export COMPOSER_ROOT_VERSION=dev-main
if ! bash "$TEST_DIR/scripts/composer-install" --no-progress >"$TEST_DIR/install.log" 2>&1; then
    cat "$TEST_DIR/install.log" >&2
    exit 1
fi

if ! cmp -s "$ROOT/composer.lock" "$TEST_DIR/composer.lock"; then
    echo 'composer install rewrote composer.lock on a fresh checkout:' >&2
    diff -u "$ROOT/composer.lock" "$TEST_DIR/composer.lock" | head -40 >&2 || true
    exit 1
fi

php -r '
    $psr4 = require $argv[1]."/vendor/composer/autoload_psr4.php";
    foreach (["Webong\\Gateway\\Centrifugo\\", "Webong\\Gateway\\Mercure\\", "Webong\\Gateway\\Reverb\\", "Webong\\Gateway\\HookScript\\", "Webong\\Gateway\\Shell\\"] as $namespace) {
        if (! isset($psr4[$namespace])) {
            fwrite(STDERR, "Workspace did not register [".$namespace."] in the autoloader.\n");
            exit(1);
        }
    }
' "$TEST_DIR"

printf 'composer.lock is unchanged by a fresh install and extension namespaces are autoloaded.\n'
