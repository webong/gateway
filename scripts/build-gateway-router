#!/bin/sh
set -eu

REPO_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
OUTPUT=${1:-$REPO_DIR/dist/gateway-router}

case "$OUTPUT" in
    /*) ;;
    *) OUTPUT="$(pwd)/$OUTPUT" ;;
esac

if [ -e "$OUTPUT" ]; then
    echo "Output already exists: $OUTPUT" >&2
    exit 1
fi
if [ ! -f "$REPO_DIR/vendor/autoload.php" ] || [ ! -x "$REPO_DIR/vendor/bin/roadrunner-worker" ]; then
    echo 'Install Planner dependencies first: composer install --working-dir=app' >&2
    exit 1
fi

mkdir -p "$(dirname -- "$OUTPUT")"
STAGE=$(mktemp -d "${OUTPUT}.tmp.XXXXXX")
mkdir -p "$STAGE/bin" "$STAGE/scripts" "$STAGE/app" "$STAGE/src"

cp -R "$REPO_DIR/src/planner" "$STAGE/src/"
cp -R "$REPO_DIR/ext" "$STAGE/"
mkdir -p "$STAGE/lib"
cp -R "$REPO_DIR/lib/contract" "$STAGE/lib/"
cp "$REPO_DIR/composer.json" "$STAGE/"
cp "$REPO_DIR/scripts/gateway-router" "$REPO_DIR/scripts/router-start" \
    "$REPO_DIR/scripts/router-artisan" "$STAGE/scripts/"
APP_SOURCE="$REPO_DIR/app"
APP_TARGET="$STAGE/app"
cp -R "$REPO_DIR/vendor" "$STAGE/"
# Composer's path repository is copied rather than symlinked. Refresh the
# staged package from this checkout so Planner edits cannot ship stale vendor
# contents from an earlier composer install.
if [ -d "$STAGE/vendor/webong/gateway" ]; then
    cp -R "$REPO_DIR/src/planner" "$STAGE/vendor/webong/gateway/src/"
    mkdir -p "$STAGE/vendor/webong/gateway/lib"
    cp -R "$REPO_DIR/lib/contract" "$STAGE/vendor/webong/gateway/lib/"
    cp "$REPO_DIR/composer.json" "$STAGE/vendor/webong/gateway/composer.json"
fi
cp "$APP_SOURCE/artisan" "$APP_SOURCE/Caddyfile" \
    "$APP_SOURCE/composer.json" "$APP_SOURCE/composer.lock" \
    "$APP_SOURCE/bootstrap.php" "$APP_SOURCE/config.php" "$APP_SOURCE/index.php" "$APP_SOURCE/commands.php" \
    "$APP_SOURCE/routes.php" "$APP_SOURCE/EndpointPathResolver.php" "$APP_TARGET/"

GOTELEMETRY=off go -C "$REPO_DIR/ext/roadrunner/cmd/router" build -mod=mod -o "$STAGE/bin/gateway-router-roadrunner" .
if [ -n "${GATEWAY_ROUTER_FRANKENPHP_BIN:-}" ]; then
    if [ ! -x "$GATEWAY_ROUTER_FRANKENPHP_BIN" ]; then
        echo "FrankenPHP binary is not executable: $GATEWAY_ROUTER_FRANKENPHP_BIN" >&2
        exit 1
    fi
    cp "$GATEWAY_ROUTER_FRANKENPHP_BIN" "$STAGE/bin/gateway-frankenphp"
fi
if [ -n "${GATEWAY_ROUTER_LIBRARY_BIN:-}" ]; then
    if [ ! -x "$GATEWAY_ROUTER_LIBRARY_BIN" ]; then
        echo "FrankenPHP library Router is not executable: $GATEWAY_ROUTER_LIBRARY_BIN" >&2
        exit 1
    fi
    cp "$GATEWAY_ROUTER_LIBRARY_BIN" "$STAGE/bin/gateway-router-library"
fi
mv "$STAGE" "$OUTPUT"
echo "Gateway Router distribution: $OUTPUT"
