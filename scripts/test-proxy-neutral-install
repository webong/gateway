#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
WORK=$(mktemp -d "${TMPDIR:-/tmp}/gateway-proxy-neutral.XXXXXX")
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$WORK/pkg" "$WORK/mod" "$WORK/app/ext"
cp -R "$ROOT/pkg/planner" "$WORK/pkg/planner"
cp -R "$ROOT/mod/adapter" "$WORK/mod/adapter"
cp -R "$ROOT/app/ext/proxy" "$WORK/app/ext/proxy"
cp "$ROOT/composer.bootstrap.json" "$WORK/composer.json"
COMPOSER_ROOT_VERSION=dev-main composer install --working-dir="$WORK" --no-interaction --no-scripts --prefer-dist --no-progress
php -r '
$p=$argv[1]."/composer.json"; $m=json_decode(file_get_contents($p),true);
$m["minimum-stability"]="dev"; $m["prefer-stable"]=true;
$m["require"]["webong/gateway"]="dev-main";
$m["require"]["webong/proxy"]="^0.4";
$m["extra"]["source-plugin"]["workspaces"]=["include"=>["mod/adapter","pkg/planner","app/ext/proxy"],"symlink"=>false];
file_put_contents($p,json_encode($m,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES)."\n");
' "$WORK"
COMPOSER_ROOT_VERSION=dev-main composer update --working-dir="$WORK" --no-interaction --no-scripts --prefer-dist --no-progress
php -r '
require $argv[1]."/vendor/autoload.php";
foreach (["laravel/framework","webong/proxy-laravel","spatie/laravel-webhook-client","spatie/laravel-webhook-server"] as $name) {
    if (Composer\InstalledVersions::isInstalled($name)) { throw new RuntimeException("Neutral Planner unexpectedly requires ".$name); }
}
if (!class_exists(Webong\Gateway\Symfony\GatewayBundle::class) || !interface_exists(Webong\Proxy\Registry\Contracts\EndpointRepository::class)) { throw new RuntimeException("Neutral public API missing"); }
if (Composer\InstalledVersions::getPrettyVersion("webong/proxy")!=="0.4.0") { throw new RuntimeException("Wrong Proxy"); }
' "$WORK"
echo 'Neutral Planner and Proxy 0.4 install without Laravel, Spatie or the Laravel adapter.'

# The optional Laravel registry adapter must migrate without installing Web.
php -r '
$p=$argv[1]."/composer.json";$m=json_decode(file_get_contents($p),true);
$m["require"]["webong/proxy-laravel"]="^0.4";$m["require"]["laravel/framework"]="^12.0";
$m["extra"]["source-plugin"]["workspaces"]["include"][]="app/ext/proxy/adapters/laravel";
file_put_contents($p,json_encode($m,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES)."\n");
' "$WORK"
COMPOSER_ROOT_VERSION=dev-main composer update --working-dir="$WORK" --no-interaction --no-scripts --prefer-dist --no-progress
mkdir -p "$WORK/bootstrap/cache" "$WORK/storage/framework/cache/data" "$WORK/storage/framework/views"
touch "$WORK/gateway.sqlite"
APP_ENV=testing php -- "$WORK" <<'PHP'
<?php
require $argv[1].'/vendor/autoload.php';
if (Composer\InstalledVersions::isInstalled('webong/gateway-web')) {
    throw new RuntimeException('This consumer must not install Web.');
}
$app = Illuminate\Foundation\Application::configure(basePath: $argv[1])->create();
$app->afterBootstrapping(Illuminate\Foundation\Bootstrap\LoadConfiguration::class, static function ($app) use ($argv): void {
    $app['config']->set('database.default', 'sqlite');
    $app['config']->set('database.connections.sqlite', ['driver' => 'sqlite', 'database' => $argv[1].'/gateway.sqlite', 'prefix' => '', 'foreign_key_constraints' => true]);
});
$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);
$kernel->bootstrap();
foreach ([1, 2] as $_) {
    if ($kernel->call('gateway:migrate', ['--force' => true]) !== 0) {
        throw new RuntimeException($kernel->output());
    }
}
$pdo = new PDO('sqlite:'.$argv[1].'/gateway.sqlite');
foreach (['endpoints', 'subscriptions', 'profiles', 'gateway_migrations', 'migrations'] as $table) {
    if (!$pdo->query("SELECT name FROM sqlite_master WHERE type='table' AND name=".$pdo->quote($table))->fetchColumn()) {
        throw new RuntimeException('Missing schema '.$table);
    }
}
echo "Laravel Proxy schema is discovered and repeatable without Web installed.\n";
PHP
