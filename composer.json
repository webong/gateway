{
    "name": "webong/gateway-hookscript",
    "description": "Primi-powered HookScript extension for Gateway",
    "type": "library",
    "license": "MIT",
    "require": {
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "php": "^8.3",
        "smuuf/primi": "^0.4",
        "webong/gateway": "dev-main",
        "webong/gateway-planner": "dev-main"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Gateway\\HookScript\\": "src/"
        },
        "files": [
            "register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Gateway\\HookScript\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webong\\Gateway\\HookScript\\HookScriptExtensionServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}