{
    "name": "webong/gateway",
    "description": "Laravel control-plane contract for the gateway Go transport",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0",
        "webong/proxy": "dev-feature/proxy-package"
    },
    "require-dev": {
        "laravel/reverb": "^1.10",
        "laravel/octane": "^2.17",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "smuuf/primi": "^0.4",
        "spiral/roadrunner-cli": "^2.6",
        "spiral/roadrunner-http": "^3.3",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "webong/proxy",
                "version": "dev-feature/proxy-package",
                "type": "library",
                "source": {
                    "type": "git",
                    "url": "https://github.com/webong/proxy.git",
                    "reference": "b01cf9c646507556cf4d7781b8638f5533a3b011"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/webong/proxy/zipball/b01cf9c646507556cf4d7781b8638f5533a3b011",
                    "reference": "b01cf9c646507556cf4d7781b8638f5533a3b011"
                },
                "require": {
                    "php": "^8.3 || ^8.4",
                    "guzzlehttp/guzzle": "^7.10",
                    "illuminate/contracts": "^12.0",
                    "illuminate/support": "^12.0",
                    "spatie/laravel-webhook-client": "^3.5",
                    "spatie/laravel-webhook-server": "^3.10"
                },
                "autoload": {
                    "psr-4": {
                        "Webong\\WebProxy\\": "src/"
                    }
                },
                "extra": {
                    "laravel": {
                        "providers": ["Webong\\WebProxy\\WebProxyServiceProvider"]
                    }
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Webong\\Gateway\\Contracts\\": "lib/contract/src/Contracts/",
            "Webong\\Gateway\\Protocol\\": "lib/contract/src/Protocol/",
            "Webong\\Gateway\\": "src/planner/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Gateway\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/*",
            "/.*",
            "!/composer.json",
            "!/LICENSE",
            "!/README.md",
            "!/src",
            "/src/*",
            "!/src/planner",
            "!/src/planner/**",
            "!/lib",
            "/lib/*",
            "!/lib/contract",
            "/lib/contract/*",
            "!/lib/contract/src",
            "!/lib/contract/src/**"
        ]
    },
    "scripts": {
        "test": "pest",
        "test-package": "bash scripts/test-planner-package"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "ext/*/composer.json"
            ],
            "recurse": false,
            "replace": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-scripts": false
        },
        "laravel": {
            "providers": [
                "Webong\\Gateway\\GatewayServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    }
}
