{
    "name": "webong/gateway-javascript",
    "description": "JavaScript automation extension for Gateway",
    "type": "library",
    "license": "MIT",
    "require": {
        "laravel/framework": "^12.0",
        "php": "^8.3",
        "webong/gateway": "dev-main",
        "webong/gateway-adapter": "dev-main",
        "webong/proxy": "^0.3.1"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Gateway\\JavaScript\\": "php/src/"
        },
        "files": [
            "php/register.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webong\\Gateway\\JavaScript\\JavaScriptExtensionServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
