{
    "name": "webong/gateway-monorepo",
    "description": "Development workspace for Webong Gateway",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "laravel/octane": "^2.17",
        "laravel/reverb": "^1.10",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "smuuf/primi": "^0.4",
        "spiral/roadrunner-cli": "^2.6",
        "spiral/roadrunner-http": "^3.3",
        "symfony/framework-bundle": "^7.3",
        "webong/composer-source-plugin": "^0.4",
        "webong/gateway": "dev-main",
        "webong/gateway-adapter": "dev-main",
        "webong/gateway-builder": "dev-main",
        "webong/gateway-centrifugo": "dev-main",
        "webong/gateway-database": "dev-main",
        "webong/gateway-dns": "dev-main",
        "webong/gateway-email": "dev-main",
        "webong/gateway-hookscript": "dev-main",
        "webong/gateway-javascript": "dev-main",
        "webong/gateway-lua": "dev-main",
        "webong/gateway-mercure": "dev-main",
        "webong/gateway-reverb": "dev-main",
        "webong/gateway-shell": "dev-main",
        "webong/gateway-web": "dev-main",
        "webong/proxy": "^0.3.1",
        "workerman/workerman": "^5.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Webong\\Gateway\\Tests\\": "tests/",
            "Webong\\Gateway\\Centrifugo\\Tests\\": "pkg/centrifugo/tests/",
            "Webong\\Gateway\\HookScript\\Tests\\": "pkg/hookscript/tests/",
            "Webong\\Gateway\\Mercure\\Tests\\": "pkg/mercure/tests/",
            "Webong\\Gateway\\Reverb\\Tests\\": "pkg/reverb/tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-package": "bash scripts/test-core-package"
    },
    "extra": {
        "source-plugin": {
            "workspaces": [
                "mod/adapter",
                "mod/builder",
                "pkg/*"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "webong/composer-source-plugin": true,
            "webong/gateway-builder": true
        },
        "sort-packages": true
    }
}
