{
    "name": "webong/gateway-monorepo",
    "description": "Development workspace for Webong Gateway",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "laravel/octane": "^2.17",
        "laravel/reverb": "^1.10",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "smuuf/primi": "^0.4",
        "spiral/roadrunner-cli": "^2.6",
        "spiral/roadrunner-http": "^3.3",
        "webong/composer-source-plugin": "^0.2",
        "webong/gateway-builder": "dev-main",
        "webong/gateway-database": "dev-main",
        "webong/gateway-dns": "dev-main",
        "webong/gateway-email": "dev-main",
        "webong/gateway": "dev-main",
        "webong/gateway-adapter": "dev-main",
        "webong/gateway-web": "dev-main",
        "workerman/workerman": "^5.2",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "mod/builder",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "mod/adapter",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "pkg/planner",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "pkg/web",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "pkg/dns",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "pkg/email",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "pkg/database",
            "options": {"symlink": true}
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Webong\\Gateway\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test-package": "bash scripts/test-core-package"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "pkg/*/composer.json"
            ],
            "exclude": [
                "pkg/hookscript/composer.json"
            ],
            "recurse": false,
            "replace": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-scripts": false
        },
        "source-plugin": {
            "loaders": {
                "webong/gateway": {
                    "type": "auto",
                    "path": "pkg/planner",
                    "manifest": "pkg/planner/composer.json"
                },
                "webong/gateway-adapter": {
                    "type": "auto",
                    "path": "mod/adapter",
                    "manifest": "mod/adapter/composer.json"
                },
                "webong/gateway-builder": {
                    "type": "auto",
                    "path": "mod/builder",
                    "manifest": "mod/builder/composer.json"
                }
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "webong/composer-source-plugin": true,
            "webong/gateway-builder": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    }
}
