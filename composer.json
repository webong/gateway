{
    "name": "webong/gateway",
    "description": "Framework-free contracts and protocol for the Webong Gateway transport",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "laravel/octane": "^2.17",
        "laravel/reverb": "^1.10",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "smuuf/primi": "^0.4",
        "spiral/roadrunner-cli": "^2.6",
        "spiral/roadrunner-http": "^3.3",
        "webong/gateway-planner": "dev-main",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "pkg/planner",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Webong\\Gateway\\Companion\\": "mod/adapter/src/Companion/",
            "Webong\\Gateway\\Contracts\\": "mod/adapter/src/Contract/",
            "Webong\\Gateway\\Protocols\\": "mod/adapter/src/Protocol/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Gateway\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/*",
            "/.*",
            "!/composer.json",
            "!/LICENSE",
            "!/README.md",
            "!/mod",
            "/mod/*",
            "!/mod/adapter",
            "/mod/adapter/*",
            "!/mod/adapter/src",
            "!/mod/adapter/src/**"
        ]
    },
    "scripts": {
        "test": "pest",
        "test-package": "bash scripts/test-core-package"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "pkg/*/composer.json"
            ],
            "exclude": [
                "pkg/webhookscript/composer.json"
            ],
            "recurse": false,
            "replace": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-scripts": false
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    }
}
