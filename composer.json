{
    "name": "webong/web",
    "description": "Planner entrypoint for Gateway's Web extension",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "webong/gateway": "dev-main",
        "webong/gateway-planner": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Gateway\\Events\\": "src/Events/",
            "Webong\\Gateway\\Web\\": "src/",
            "Webong\\Gateway\\Webstream\\": "src/Webstream/"
        },
        "files": ["register.php"]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
