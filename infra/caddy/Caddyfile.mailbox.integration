{
	gateway_pop3 {
		listen 127.0.0.1:1995
		planner_url http://127.0.0.1:8081
		internal_token test-only
		tls_cert_file /tmp/mail.crt
		tls_key_file /tmp/mail.key
		upstream_ca_file /tmp/upstream-ca.crt
		upstream primary pop.internal:995 pop.internal
	}
	gateway_imap {
		listen 127.0.0.1:1993
		planner_url http://127.0.0.1:8081
		internal_token test-only
		tls_cert_file /tmp/mail.crt
		tls_key_file /tmp/mail.key
		upstream_ca_file /tmp/upstream-ca.crt
		upstream primary imap.internal:993 imap.internal
	}
}

127.0.0.1:18080 {
	respond "ok"
}
