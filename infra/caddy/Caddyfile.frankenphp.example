{
	frankenphp {
		worker {
			file {$APP_PUBLIC_PATH}/frankenphp-worker.php
		}
	}

	# Protocol listeners such as SMTP, IMAP, and POP3 belong to activated
	# Extensions. The generic Caddy host reconciles those packages from Planner;
	# it does not expose protocol-specific Caddy directives.
}

{$SERVER_NAME:localhost} {
	root * {$APP_PUBLIC_PATH}
	encode zstd gzip

	route {
		# The Go gateway is the first application handler. It calls the next
		# handler for PHP planning and ordinary Laravel pass-through requests.
		gateway {
			internal_token {$GATEWAY_INTERNAL_TOKEN}
			# For a separate provisioning worker, set only reachable workload networks:
			# managed_route_cidrs 10.244.0.0/16
			max_body_size 10485760
			max_workers 100
			max_queue_size 1000
			# The queue is shared by host and Extension-provided adapters. Caddy
			# reloads that overlap spool workers are rejected; restart to apply changes
			# while durable delivery is enabled.
			# spool_path /var/mod/gateway/deliveries
			# delivery_database_url {$GATEWAY_DELIVERY_DATABASE_URL}
			# admin_addr 127.0.0.1:5052
			# receipt_retention 2160h
		}

		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			resolve_root_symlink
		}
	}
}
